+/// fsnotify event bits, for a file system that learns of changes from elsewhere and reports
+/// them to watchers the way the VFS does for changes it makes itself.
+pub mod notify {
+    /// File contents changed.
+    pub const MODIFY: u32 = bindings::FS_MODIFY;
+    /// Attributes changed.
+    pub const ATTRIB: u32 = bindings::FS_ATTRIB;
+    /// A writable file was closed.
+    pub const CLOSE_WRITE: u32 = bindings::FS_CLOSE_WRITE;
+    /// An entry was moved out of a directory.
+    pub const MOVED_FROM: u32 = bindings::FS_MOVED_FROM;
+    /// An entry was moved into a directory.
+    pub const MOVED_TO: u32 = bindings::FS_MOVED_TO;
+    /// An entry was created.
+    pub const CREATE: u32 = bindings::FS_CREATE;
+    /// An entry was removed.
+    pub const DELETE: u32 = bindings::FS_DELETE;
+    /// The inode itself was removed.
+    pub const DELETE_SELF: u32 = bindings::FS_DELETE_SELF;
+    /// The inode itself was moved.
+    pub const MOVE_SELF: u32 = bindings::FS_MOVE_SELF;
+    /// The entry the event is about is a directory.
+    pub const ISDIR: u32 = bindings::FS_ISDIR;
+}
