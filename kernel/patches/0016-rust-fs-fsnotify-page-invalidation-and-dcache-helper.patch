diff --git a/rust/kernel/fs/inode.rs b/rust/kernel/fs/inode.rs
index de0415de4..04b8075e9 100644
--- a/rust/kernel/fs/inode.rs
+++ b/rust/kernel/fs/inode.rs
@@ -137,6 +137,76 @@ pub fn set_attr(&self, attr: &Attr) {
         }
     }
 
+    /// Drops every page of this inode from the page cache, including pages mapped into
+    /// processes, so the next access reads the backing store again.
+    pub fn invalidate_pages(&self) {
+        // SAFETY: The inode is valid and `i_mapping` points at a mapping that outlives it.
+        unsafe { bindings::invalidate_inode_pages2((*self.0.get()).i_mapping) };
+    }
+
+    /// Marks the inode as having no links left, as the VFS does when its last name goes.
+    pub fn clear_nlink(&self) {
+        // SAFETY: The inode is valid.
+        unsafe { bindings::clear_nlink(self.0.get()) };
+    }
+
+    /// Reports an event about this inode itself to its watchers.
+    pub fn notify(&self, mask: u32) {
+        let inode = self.0.get();
+        // SAFETY: The inode is valid. This is `fsnotify_inode`.
+        unsafe {
+            bindings::fsnotify(
+                mask,
+                inode.cast(),
+                bindings::fsnotify_data_type_FSNOTIFY_EVENT_INODE as _,
+                ptr::null_mut(),
+                ptr::null(),
+                inode,
+                0,
+            )
+        };
+    }
+
+    /// Reports that `name` in this directory was created, removed or moved, to the watchers of
+    /// this directory. `entry` is the inode behind the name when there is one.
+    pub fn notify_dirent(&self, mask: u32, name: &[u8], entry: Option<&INode<T>>, cookie: u32) {
+        let Some(qname) = qstr_of(name) else { return };
+        let data = entry.map_or(self.0.get(), |e| e.0.get());
+        // SAFETY: Both inodes are valid and `qname` outlives the call. This is `fsnotify_name`,
+        // with the directory standing in as the data object when the entry's inode is unknown;
+        // directory watchers only consult the directory and the name.
+        unsafe {
+            bindings::fsnotify(
+                mask,
+                data.cast(),
+                bindings::fsnotify_data_type_FSNOTIFY_EVENT_INODE as _,
+                self.0.get(),
+                &qname,
+                ptr::null_mut(),
+                cookie,
+            )
+        };
+    }
+
+    /// Reports an event on `child`, known as `name` in this directory, to the child's watchers
+    /// and to the watchers of this directory's children.
+    pub fn notify_child(&self, mask: u32, name: &[u8], child: &INode<T>) {
+        let Some(qname) = qstr_of(name) else { return };
+        // SAFETY: Both inodes are valid and `qname` outlives the call. This is what
+        // `fsnotify_parent` does once it holds the parent.
+        unsafe {
+            bindings::fsnotify(
+                mask | bindings::FS_EVENT_ON_CHILD,
+                child.0.get().cast(),
+                bindings::fsnotify_data_type_FSNOTIFY_EVENT_INODE as _,
+                self.0.get(),
+                &qname,
+                child.0.get(),
+                0,
+            )
+        };
+    }
+
     pub(crate) fn new_cache() -> Result<Option<MemCache>> {
         Ok(if size_of::<T::INodeData>() == 0 {
             None
@@ -255,6 +325,17 @@ struct WithData<T> {
     inode: bindings::inode,
 }
 
+/// Builds a `qstr` over `name`. The result borrows `name` and must not outlive it.
+fn qstr_of(name: &[u8]) -> Option<bindings::qstr> {
+    let len = u32::try_from(name.len()).ok()?;
+    Some(bindings::qstr {
+        __bindgen_anon_1: bindings::qstr__bindgen_ty_1 {
+            __bindgen_anon_1: bindings::qstr__bindgen_ty_1__bindgen_ty_1 { hash: 0, len },
+        },
+        name: name.as_ptr(),
+    })
+}
