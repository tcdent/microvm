+}
+
+/// The bound session whose tag is `tag`.
+fn session_by_tag(tag: &[u8]) -> Option<Arc<Session>> {
+    SESSIONS.lock().iter().find(|s| s.tag.as_slice() == tag).cloned()
 }
 
