From: tcdent <tcdent@gmail.com>
Date: Mon, 12 Oct 2026 18:09:02 -0700
Subject: [PATCH 38/38] fs: sharedfs: hard links

link(2) failed with EPERM, so cargo's incremental cache fell back to
copying and git's local clones could not link objects. The host now
links the file and the new name gets an index entry of its own, as a
hard link made on the host already does; the guest instantiates it as a
separate inode reaching the same data. The host refreshes every name of
a multiply linked file when one is added or removed, so link counts stay
right. Names of one file do not share an inode number in the guest.

Reported-by: tablet.lead@a10k.internal
Claude-Session: https://claude.ai/code/session_01SKmspe5nVbuvzdvYZa9UhW
---
 fs/sharedfs/queue.rs    |  1 +
 fs/sharedfs/sharedfs.rs | 15 +++++++++++++++
 2 files changed, 16 insertions(+)

diff --git a/fs/sharedfs/queue.rs b/fs/sharedfs/queue.rs
index 3ee4b5d88..2dddb19e3 100644
--- a/fs/sharedfs/queue.rs
+++ b/fs/sharedfs/queue.rs
@@ -45,6 +45,7 @@ pub(crate) mod op {
     pub const RELEASE_WRITE: u32 = 19;
     pub const OPEN_READ: u32 = 20;
     pub const RELEASE_READ: u32 = 21;
+    pub const LINK: u32 = 22;
 }
 
 /// MAP flag bits, shared with the host.
diff --git a/fs/sharedfs/sharedfs.rs b/fs/sharedfs/sharedfs.rs
index 766696afc..b1fc31ea7 100644
--- a/fs/sharedfs/sharedfs.rs
+++ b/fs/sharedfs/sharedfs.rs
@@ -610,6 +610,21 @@ fn symlink(
         SharedFs::create_entry(parent, &mut req)
     }
 
+    /// The host links the file; the new name is an entry of its own in the index, so it gets an
+    /// inode of its own here too, reaching the same data. The old name's link count is
+    /// refreshed.
+    fn link(
+        old: &DEntry<SharedFs>,
+        parent: &Locked<&INode<SharedFs>, inode::WriteSem>,
+        dentry: dentry::Unhashed<'_, SharedFs>,
+    ) -> Result<ARef<INode<SharedFs>>> {
+        let src = old.inode().ok_or(ENOENT)?;
+        let mut req = Req::new(op::LINK).u64(src.ino()).u64(parent.ino()).bytes(dentry.name());
+        let inode = SharedFs::create_entry(parent, &mut req)?;
+        SharedFs::refresh(src);
+        Ok(inode)
+    }
+
     fn unlink(parent: &Locked<&INode<SharedFs>, inode::WriteSem>, dentry: &DEntry<SharedFs>) -> Result {
         let mut req = Req::new(op::UNLINK).u64(parent.ino()).bytes(dentry.name());
         SharedFs::simple(parent, &mut req)?;
