+++ b/rust/kernel/sync/locked.rs
@@ -0,0 +1,77 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! Proof that a lock embedded in a value is held.
+
+use core::{marker::PhantomData, ops::Deref};
+
+/// A type whose instances carry a lock of their own.
+///
+/// `Marker` tells lock modes apart when a type has more than one, for example shared and
+/// exclusive holds of an rw semaphore.
+///
+/// # Safety
+///
+/// `raw_lock` must acquire the lock and `unlock` must release it, so that a [`Locked`] wrapping
+/// the value is proof that the lock is held.
+pub unsafe trait Lockable<Marker = ()> {
+    /// Acquires the lock.
+    fn raw_lock(&self);
+
+    /// Releases the lock.
+    ///
+    /// # Safety
+    ///
+    /// The lock must be held by the caller.
+    unsafe fn unlock(&self);
+}
+
+/// A value whose embedded lock is held.
+///
+/// Dropping it releases the lock. Callbacks that receive a value the VFS has already locked, and
+/// that the VFS will unlock itself, wrap the guard in `ManuallyDrop` so the proof exists without a
+/// second unlock.
+pub struct Locked<T: Deref, Marker = ()>(T, PhantomData<Marker>)
+where
+    T::Target: Lockable<Marker>;
+
+impl<T: Deref, Marker> Locked<T, Marker>
+where
+    T::Target: Lockable<Marker>,
+{
+    /// Acquires the lock and wraps the value.
+    pub fn lock(value: T) -> Self {
+        value.raw_lock();
+        Self(value, PhantomData)
+    }
+
+    /// Wraps a value whose lock is already held.
+    ///
+    /// # Safety
+    ///
+    /// The lock must be held by the caller, who transfers responsibility for releasing it to the
+    /// returned guard.
+    pub unsafe fn new(value: T) -> Self {
+        Self(value, PhantomData)
+    }
+}
+
+impl<T: Deref, Marker> Deref for Locked<T, Marker>
+where
+    T::Target: Lockable<Marker>,
+{
+    type Target = T;
+
+    fn deref(&self) -> &T {
+        &self.0
+    }
+}
+
+impl<T: Deref, Marker> Drop for Locked<T, Marker>
+where
+    T::Target: Lockable<Marker>,
+{
+    fn drop(&mut self) {
+        // SAFETY: By the type invariants, the lock is held.
+        unsafe { self.0.unlock() };
+    }
+}
