From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tcdent <tcdent@gmail.com>
Date: Mon, 12 Oct 2026 13:42:26 -0700
Subject: [PATCH 28/38] rust: fs: file open and release hooks

Add `open` and `release` to `file::Operations`, wired to the
`file_operations` callbacks, and `File::is_writable`, which reports the
access granted at open rather than the inode's current mode.

Claude-Session: https://claude.ai/code/session_01SKmspe5nVbuvzdvYZa9UhW
---
 rust/kernel/fs/file.rs | 50 ++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 50 insertions(+)

diff --git a/rust/kernel/fs/file.rs b/rust/kernel/fs/file.rs
index 01b6d6114..117d9ffbc 100644
--- a/rust/kernel/fs/file.rs
+++ b/rust/kernel/fs/file.rs
@@ -347,6 +347,13 @@ pub fn flags(&self) -> u32 {
         // FIXME(read_once): Replace with `read_once` when available on the Rust side.
         unsafe { core::ptr::addr_of!((*self.as_ptr()).f_flags).read_volatile() }
     }
+
+    /// Whether the file was opened for writing: the access granted at open, which holds for
+    /// the life of the file whatever happens to the inode's mode afterwards.
+    #[inline]
+    pub fn is_writable(&self) -> bool {
+        self.flags() & flags::O_ACCMODE != flags::O_RDONLY
+    }
 }
 
 impl File {
@@ -519,6 +526,14 @@ fn write_iter(
         Err(EINVAL)
     }
 
+    /// Called when the file is opened, after the VFS has checked access against the inode.
+    fn open(_inode: &INode<Self::FileSystem>, _file: &File) -> Result {
+        Ok(())
+    }
+
+    /// Called when the last reference to the open file goes away.
+    fn release(_inode: &INode<Self::FileSystem>, _file: &File) {}
+
     /// Sets up a new memory mapping of the file.
     fn mmap(_file: &File, _inode: &INode<Self::FileSystem>, _vma: &VmaNew) -> Result {
         Err(ENODEV)
@@ -581,9 +596,44 @@ impl<T: Operations + ?Sized> Table<T> {
                 } else {
                     None
                 },
+                open: if T::HAS_OPEN {
+                    Some(Self::open_callback)
+                } else {
+                    None
+                },
+                release: if T::HAS_RELEASE {
+                    Some(Self::release_callback)
+                } else {
+                    None
+                },
                 ..pin_init::zeroed()
             };
 
+            unsafe extern "C" fn open_callback(
+                inode_ptr: *mut bindings::inode,
+                file_ptr: *mut bindings::file,
+            ) -> core::ffi::c_int {
+                from_result(|| {
+                    // SAFETY: The C API passes a valid inode of this file system and the file
+                    // being opened on it.
+                    let inode = unsafe { INode::from_raw(inode_ptr) };
+                    let file = unsafe { File::from_raw_file(file_ptr) };
+                    T::open(inode, file)?;
+                    Ok(0)
+                })
+            }
+
+            unsafe extern "C" fn release_callback(
+                inode_ptr: *mut bindings::inode,
+                file_ptr: *mut bindings::file,
+            ) -> core::ffi::c_int {
+                // SAFETY: As for `open_callback`; the file is valid until this returns.
+                let inode = unsafe { INode::from_raw(inode_ptr) };
+                let file = unsafe { File::from_raw_file(file_ptr) };
+                T::release(inode, file);
+                0
+            }
+
             /// The file's inode as this file system's type.
             ///
             /// # Safety
