+            /// The directory the VFS locked exclusively before calling a mutating operation.
+            ///
+            /// # Safety
+            ///
+            /// `dir` must be a valid inode whose rw semaphore is held exclusively.
+            unsafe fn locked_dir<'a>(
+                dir: *mut bindings::inode,
+            ) -> ManuallyDrop<Locked<&'a INode<T::FileSystem>, WriteSem>> {
+                // SAFETY: Per the safety requirements.
+                let parent = unsafe { INode::from_raw(dir) };
+                // SAFETY: The VFS holds the lock and expects it to be held on return, hence
+                // the `ManuallyDrop`.
+                ManuallyDrop::new(unsafe { Locked::new(parent) })
+            }
+
+            unsafe extern "C" fn create_callback(
+                _idmap: *mut bindings::mnt_idmap,
+                dir: *mut bindings::inode,
+                dentry_ptr: *mut bindings::dentry,
+                mode: bindings::umode_t,
+                excl: bool,
+            ) -> ffi::c_int {
+                from_result(|| {
+                    // SAFETY: The VFS passes a valid, exclusively locked directory.
+                    let parent = unsafe { Self::locked_dir(dir) };
+                    // SAFETY: The VFS passes a valid, unhashed dentry.
+                    let dentry = unsafe { DEntry::from_raw(dentry_ptr) };
+                    let inode = T::create(&parent, dentry::Unhashed(dentry), mode & 0o7777, excl)?;
+                    dentry::Unhashed(dentry).instantiate(inode)?;
+                    Ok(0)
+                })
+            }
+
+            unsafe extern "C" fn mkdir_callback(
+                _idmap: *mut bindings::mnt_idmap,
+                dir: *mut bindings::inode,
+                dentry_ptr: *mut bindings::dentry,
+                mode: bindings::umode_t,
+            ) -> *mut bindings::dentry {
+                let result = (|| {
+                    // SAFETY: The VFS passes a valid, exclusively locked directory.
+                    let parent = unsafe { Self::locked_dir(dir) };
+                    // SAFETY: The VFS passes a valid, unhashed dentry.
+                    let dentry = unsafe { DEntry::from_raw(dentry_ptr) };
+                    let inode = T::mkdir(&parent, dentry::Unhashed(dentry), mode & 0o7777)?;
+                    dentry::Unhashed(dentry).instantiate(inode)
+                })();
+                match result {
+                    // Null tells the VFS the dentry it passed is the one to use.
+                    Ok(()) => ptr::null_mut(),
+                    Err(e) => e.to_ptr(),
+                }
+            }
+
