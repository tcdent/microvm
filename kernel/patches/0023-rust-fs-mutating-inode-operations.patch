+            unsafe extern "C" fn rename_callback(
+                _idmap: *mut bindings::mnt_idmap,
+                old_dir: *mut bindings::inode,
+                old_ptr: *mut bindings::dentry,
+                new_dir: *mut bindings::inode,
+                new_ptr: *mut bindings::dentry,
