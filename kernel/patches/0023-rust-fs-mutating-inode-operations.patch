+/// The attribute changes a `setattr` call asks for.
+///
+/// Wraps the kernel's `struct iattr`: each accessor returns `Some` only for an attribute the
+/// caller is changing. Times are as the VFS filled them in, so a `touch` reads as the current
+/// time.
+#[repr(transparent)]
+pub struct SetAttr(Opaque<bindings::iattr>);
+
+impl SetAttr {
+    /// # Safety
+    ///
+    /// `ptr` must be valid for the lifetime of the returned reference.
+    unsafe fn from_raw<'a>(ptr: *mut bindings::iattr) -> &'a Self {
+        // SAFETY: Per the safety requirements; `SetAttr` is a transparent wrapper.
+        unsafe { &*ptr.cast() }
+    }
+
+    fn raw(&self) -> &bindings::iattr {
+        // SAFETY: The wrapped struct is valid and only read while this reference lives.
+        unsafe { &*self.0.get() }
+    }
+
+    fn has(&self, bit: u32) -> bool {
+        self.raw().ia_valid & bit != 0
+    }
+
+    /// The `ATTR_*` bits of the change.
+    pub fn valid(&self) -> u32 {
+        self.raw().ia_valid
+    }
+
+    /// New permission bits, type bits excluded.
+    pub fn mode(&self) -> Option<u16> {
+        self.has(bindings::ATTR_MODE).then(|| self.raw().ia_mode & 0o7777)
+    }
+
+    /// New owner.
+    pub fn uid(&self) -> Option<u32> {
+        // SAFETY: Both halves of the union hold the same value.
+        self.has(bindings::ATTR_UID).then(|| unsafe { self.raw().__bindgen_anon_1.ia_uid.val })
+    }
+
+    /// New group.
+    pub fn gid(&self) -> Option<u32> {
+        // SAFETY: Both halves of the union hold the same value.
+        self.has(bindings::ATTR_GID).then(|| unsafe { self.raw().__bindgen_anon_2.ia_gid.val })
+    }
+
+    /// New size.
+    pub fn size(&self) -> Option<Offset> {
+        self.has(bindings::ATTR_SIZE).then(|| self.raw().ia_size)
+    }
+
+    /// New access time.
+    pub fn atime(&self) -> Option<Timespec> {
+        self.has(bindings::ATTR_ATIME).then(|| ts(&self.raw().ia_atime))
+    }
+
+    /// New modification time.
+    pub fn mtime(&self) -> Option<Timespec> {
+        self.has(bindings::ATTR_MTIME).then(|| ts(&self.raw().ia_mtime))
+    }
+
+    /// The change time the VFS assigned to this change.
+    pub fn ctime(&self) -> Timespec {
+        ts(&self.raw().ia_ctime)
+    }
+}
+
+fn ts(t: &bindings::timespec64) -> Timespec {
+    Timespec {
+        sec: t.tv_sec,
+        nsec: u32::try_from(t.tv_nsec).unwrap_or(0),
+    }
 }
 
