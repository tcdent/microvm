From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tcdent <tcdent@gmail.com>
Date: Mon, 12 Oct 2026 13:42:26 -0700
Subject: [PATCH 29/38] fs: sharedfs: keep write access from open to last close

POSIX decides write access once, at open: a file created with mode 0444
can be written through its creator's descriptor, and a chmod after the
open does not revoke it. The host daemon reopened the file by name for
every write-side request and so checked the current mode each time,
which broke git's packfiles ("fatal: write error: Permission denied").

The driver now counts write opens per file and tells the daemon on the
first open and the last close; the daemon holds one handle meanwhile and
uses it for mapping writable chunks, growing and truncating. A file this
guest created adopts the handle the daemon created it with. After a
resume from hibernation the open files are reopened on the new daemon.

Reported-by: tablet.kernel@a10k.internal
Claude-Session: https://claude.ai/code/session_01SKmspe5nVbuvzdvYZa9UhW
---
 fs/sharedfs/data.rs     | 79 +++++++++++++++++++++++++++++++++++++++++
 fs/sharedfs/queue.rs    | 13 ++++++-
 fs/sharedfs/sharedfs.rs | 15 ++++++++
 3 files changed, 106 insertions(+), 1 deletion(-)

diff --git a/fs/sharedfs/data.rs b/fs/sharedfs/data.rs
index ab50e6a8a..1e243f7e9 100644
--- a/fs/sharedfs/data.rs
+++ b/fs/sharedfs/data.rs
@@ -100,7 +100,86 @@ fn decode_key(private: usize) -> Key {
     ((private >> 32) as u32, private as u32)
 }
 
+/// A file the guest has open for writing; the daemon holds one write handle for it.
+pub(crate) struct Writer {
+    ino: u64,
+    /// Open files with write access.
+    count: u32,
+    /// Created by this guest and not yet opened: the daemon kept the handle it created the file
+    /// with, which the creator's open adopts (or gives back, if that open is read-only).
+    created: bool,
+}
+
 impl Session {
+    /// A file this guest just created: the daemon holds the creator's handle.
+    pub(crate) fn note_created(&self, slot: u32, ino: u64) {
+        let _ = self.writers.lock().try_create_and_insert(slot, Writer { ino, count: 0, created: true }, GFP_KERNEL);
+    }
+
+    /// An open of `slot`. The first open for writing asks the daemon for a handle, which then
+    /// carries the access the guest's VFS granted; a file just created already has one.
+    pub(crate) fn opened(&self, slot: u32, ino: u64, writable: bool) -> Result {
+        let mut writers = self.writers.lock();
+        let created = writers.get(&slot).is_some_and(|w| w.created);
+        if !writable {
+            if created && writers.get(&slot).is_some_and(|w| w.count == 0) {
+                writers.remove(&slot);
+                drop(writers);
+                let _ = self.write_request(op::RELEASE_WRITE, ino);
+            }
+            return Ok(());
+        }
+        match writers.get_mut(&slot) {
+            Some(w) => {
+                w.created = false;
+                if w.count == 0 && !created {
+                    self.write_request(op::OPEN_WRITE, ino)?;
+                }
+                w.count += 1;
+            }
+            None => {
+                self.write_request(op::OPEN_WRITE, ino)?;
+                writers
+                    .try_create_and_insert(slot, Writer { ino, count: 1, created: false }, GFP_KERNEL)
+                    .map_err(|_| ENOMEM)?;
+            }
+        }
+        Ok(())
+    }
+
+    /// The last reference to an open file of `slot` went away.
+    pub(crate) fn released(&self, slot: u32, writable: bool) {
+        if !writable {
+            return;
+        }
+        let mut writers = self.writers.lock();
+        let Some(w) = writers.get_mut(&slot) else { return };
+        w.count = w.count.saturating_sub(1);
+        if w.count == 0 {
+            let ino = w.ino;
+            writers.remove(&slot);
+            drop(writers);
+            let _ = self.write_request(op::RELEASE_WRITE, ino);
+        }
+    }
+
+    /// After a resume the daemon is a new one with no handles: ask again for every file still
+    /// open for writing. One whose mode no longer allows writing cannot be reopened; its
+    /// writers get errors from then on.
+    pub(crate) fn reopen_writers(&self) {
+        let writers = self.writers.lock();
+        for (slot, w) in writers.iter() {
+            if self.write_request(op::OPEN_WRITE, w.ino).is_err() {
+                pr_warn!("slot {}: could not reopen for writing after resume\n", slot);
+            }
+        }
+    }
+
+    fn write_request(&self, opcode: u32, ino: u64) -> Result {
+        let mut req = Req::new(opcode).u64(ino);
+        self.request(req.as_bytes(), HEADER_LEN).map(|_| ())
+    }
+
     pub(crate) fn map(&self, ino: u64, generation: u64, foff: u64, woff: u64, writable: bool) -> Result {
         let flags = if writable { map::WRITE } else { 0 };
         let mut req = Req::new(op::MAP)
