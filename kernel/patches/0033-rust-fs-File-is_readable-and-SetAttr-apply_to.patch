From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tcdent <tcdent@gmail.com>
Date: Mon, 12 Oct 2026 15:00:05 -0700
Subject: [PATCH 33/38] rust: fs: File::is_readable and SetAttr::apply_to

`is_readable` reports the read access granted at open, as `is_writable`
does for writes. `apply_to` applies an attribute change to the inode
itself, `setattr_copy` plus the size, for a file system that has nothing
to refresh the inode from.

Claude-Session: https://claude.ai/code/session_01SKmspe5nVbuvzdvYZa9UhW
---
 rust/kernel/fs/file.rs  |  6 ++++++
 rust/kernel/fs/inode.rs | 17 +++++++++++++++++
 2 files changed, 23 insertions(+)

diff --git a/rust/kernel/fs/file.rs b/rust/kernel/fs/file.rs
index 117d9ffbc..472a2b101 100644
--- a/rust/kernel/fs/file.rs
+++ b/rust/kernel/fs/file.rs
@@ -354,6 +354,12 @@ pub fn flags(&self) -> u32 {
     pub fn is_writable(&self) -> bool {
         self.flags() & flags::O_ACCMODE != flags::O_RDONLY
     }
+
+    /// Whether the file was opened for reading, as granted at open.
+    #[inline]
+    pub fn is_readable(&self) -> bool {
+        self.flags() & flags::O_ACCMODE != flags::O_WRONLY
+    }
 }
 
 impl File {
diff --git a/rust/kernel/fs/inode.rs b/rust/kernel/fs/inode.rs
index 44924e2c7..5d921587d 100644
--- a/rust/kernel/fs/inode.rs
+++ b/rust/kernel/fs/inode.rs
@@ -190,6 +190,23 @@ pub fn mtime(&self) -> Option<Timespec> {
     pub fn ctime(&self) -> Timespec {
         ts(&self.raw().ia_ctime)
     }
+
+    /// Applies the change to `inode` itself, as a file system without a backing store would:
+    /// `setattr_copy` for mode, owner and times, and the new size.
+    pub fn apply_to<T: FileSystem + ?Sized>(&self, inode: &INode<T>) {
+        // SAFETY: Both are valid; `nop_mnt_idmap` is a static the kernel never frees, and this
+        // is what `simple_setattr` does.
+        unsafe {
+            bindings::setattr_copy(
+                ptr::addr_of_mut!(bindings::nop_mnt_idmap),
+                inode.0.get(),
+                self.0.get(),
+            )
+        };
+        if let Some(size) = self.size() {
+            inode.set_size(size);
+        }
+    }
 }
 
 fn ts(t: &bindings::timespec64) -> Timespec {
