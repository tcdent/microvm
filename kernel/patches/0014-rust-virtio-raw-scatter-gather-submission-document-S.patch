diff --git a/rust/kernel/virtio/virtqueue.rs b/rust/kernel/virtio/virtqueue.rs
index 781326c17..90f576b23 100644
--- a/rust/kernel/virtio/virtqueue.rs
+++ b/rust/kernel/virtio/virtqueue.rs
@@ -256,6 +256,42 @@ pub fn add_sgs<'token, PIn, POut, Token>(
         })
     }
 
+    /// Adds raw scatter-gather lists to the virtqueue.
+    ///
+    /// `sgs` holds `out_num` device-readable lists followed by the device-writable ones. The
+    /// device writes the number of bytes it produced and `token` back through
+    /// [`Virtqueue::get_buf`].
+    ///
+    /// # Safety
+    ///
+    /// * Every entry of `sgs` must point to a scatterlist terminated with `sg_mark_end`, whose
+    ///   pages stay valid and unused by the CPU until the buffer is returned by `get_buf`.
+    /// * `token` must stay valid until it is returned by `get_buf`.
+    /// * The caller must serialise this call against other uses of the vring.
+    #[doc(alias = "virtqueue_add_sgs")]
+    pub unsafe fn add_sgs_raw(
+        &self,
+        sgs: &mut [*mut bindings::scatterlist],
+        out_num: u32,
+        token: *mut c_void,
+        gfp: Flags,
+    ) -> Result {
+        let in_num = u32::try_from(sgs.len())?
+            .checked_sub(out_num)
+            .ok_or(EINVAL)?;
+        // SAFETY: `self` is a valid virtqueue and the caller upholds the buffer requirements.
+        to_result(unsafe {
+            bindings::virtqueue_add_sgs(
+                self.as_raw(),
+                sgs.as_mut_ptr(),
+                out_num,
+                in_num,
+                token,
+                gfp.as_raw(),
+            )
+        })
+    }
+
     /// Create a scatter-gather table readable by the device.
     pub fn new_readable_sgtable<P>(
         &self,
