Subject: [PATCH 14/38] rust: virtio: raw scatter-gather submission; document
 ShmRegion

Virtqueue::add_sgs_raw takes caller-built scatterlists so a driver can
hand the device a page-cache page directly, which the SGTable path
(vmalloc-backed, DMA-mapped) cannot express. Unsafe for now: the caller
vouches for the lists and the token. Adds the sg_set_page helper.

Claude-Session: https://claude.ai/code/session_01SKmspe5nVbuvzdvYZa9UhW
---
 rust/helpers/scatterlist.c      |  6 ++++++
 rust/kernel/virtio.rs           |  2 ++
 rust/kernel/virtio/virtqueue.rs | 36 +++++++++++++++++++++++++++++++++
 3 files changed, 44 insertions(+)

diff --git a/rust/helpers/scatterlist.c b/rust/helpers/scatterlist.c
index f3c41ea5e..95c85e0c1 100644
--- a/rust/helpers/scatterlist.c
+++ b/rust/helpers/scatterlist.c
@@ -24,3 +24,9 @@ __rust_helper void rust_helper_dma_unmap_sgtable(struct device *dev,
 {
 	return dma_unmap_sgtable(dev, sgt, dir, attrs);
 }
+
+__rust_helper void rust_helper_sg_set_page(struct scatterlist *sg, struct page *page,
+					   unsigned int len, unsigned int offset)
+{
+	sg_set_page(sg, page, len, offset);
+}
diff --git a/rust/kernel/virtio.rs b/rust/kernel/virtio.rs
index dc8d728bb..e9ea63325 100644
--- a/rust/kernel/virtio.rs
+++ b/rust/kernel/virtio.rs
@@ -290,7 +290,9 @@ fn as_ref(&self) -> &crate::device::Device<Ctx> {
 /// A device-exposed shared memory region: guest-physical `addr` and `len` in bytes.
 #[derive(Clone, Copy, Debug)]
 pub struct ShmRegion {
