--- /dev/null
+++ b/fs/sharedfs/sharedfs.rs
@@ -0,0 +1,161 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! sharedfs: a filesystem whose metadata lives in host memory.
+//!
+//! The host keeps every entry's name, attributes and tree links in a shared
+//! memory index and is the only writer of it. The guest reads that index
+//! directly for lookups, attributes and directory listings, and sends
+//! mutations and file data over one virtqueue.
+//!
+//! Current stage: bind the device, map the index, check its header.
+
+use core::ptr::NonNull;
+
+use kernel::{
+    bindings,
+    device::{Bound, Core},
+    prelude::*,
+    virtio,
+    virtio::virtqueue::{VirtqueueInfo, Virtqueues},
+};
+
+/// Unassigned virtio device id used while the device is under development.
+const DEVICE_ID: u32 = 0x5346;
+/// "SHAREDFS" as a little-endian u64, as the host writes it.
+const MAGIC: u64 = u64::from_le_bytes(*b"SHAREDFS");
+const FORMAT_VERSION: u32 = 1;
+/// `MEMREMAP_WB`: cached mapping. The region is ordinary host RAM shared
+/// read-only with the guest; metadata reads want the cache.
+const MEMREMAP_WB: usize = 1;
+
+/// First page of the index region. Mirrors the host's `proto::Header`.
+#[repr(C)]
+#[derive(Clone, Copy)]
+struct Header {
+    magic: u64,
+    version: u32,
+    flags: u32,
+    entry_cap: u32,
+    table_cap: u32,
+    entries_off: u64,
+    table_off: u64,
+    region_len: u64,
+    live: u32,
+    _pad: u32,
+}
+
+/// The mapped index region.
+struct Index {
+    base: NonNull<u8>,
+    len: usize,
+}
+
+impl Index {
+    /// Map `len` bytes of the guest-physical range at `addr`.
+    ///
+    /// # Safety
+    ///
+    /// The range must be the device's shared memory region, which the host
+    /// keeps mapped for as long as the device exists.
+    unsafe fn map(addr: u64, len: u64) -> Result<Self> {
+        // SAFETY: the caller guarantees the range is device memory; `memremap` validates the
+        // request and returns null on failure.
+        let p = unsafe { bindings::memremap(addr as _, len as _, MEMREMAP_WB as _) };
+        NonNull::new(p.cast::<u8>()).map(|base| Self { base, len: len as usize }).ok_or(ENOMEM)
+    }
+
+    fn header(&self) -> Header {
+        // SAFETY: the region is at least one page and starts with a `Header`; the host may
+        // update fields at any time, so this is a volatile read of a plain-data struct.
+        unsafe { core::ptr::read_volatile(self.base.as_ptr().cast::<Header>()) }
+    }
+}
+
+impl Drop for Index {
+    fn drop(&mut self) {
+        // SAFETY: `base` came from `memremap` in `map` and is unmapped exactly once here.
+        unsafe { bindings::memunmap(self.base.as_ptr().cast()) }
+    }
+}
+
+// SAFETY: the mapping is read-only shared memory; concurrent reads from any
+// thread are fine and nothing in `Index` is thread-affine.
+unsafe impl Send for Index {}
+unsafe impl Sync for Index {}
+
+/// The device's virtqueues. The pointers inside are owned by the virtio core for the
+/// lifetime of the bound device, and the driver serializes its own use of them.
+struct Vqs(Virtqueues);
+
+// SAFETY: see `Vqs`; the virtio core guarantees the queues outlive the driver and the
+// driver never hands the same queue to two threads at once.
+unsafe impl Send for Vqs {}
+unsafe impl Sync for Vqs {}
+
+#[pin_data]
+struct SharedFs {
+    index: Index,
+    vqs: Vqs,
+}
+
+/// Request completions arrive here. Nothing is in flight yet.
+unsafe extern "C" fn requests_done(_vq: *mut bindings::virtqueue) {}
+
+impl virtio::Driver for SharedFs {
+    type IdInfo = ();
+    const ID_TABLE: virtio::IdTable<Self::IdInfo> = &SHAREDFS_TABLE;
+
+    fn probe(vdev: &virtio::Device<Core>) -> impl PinInit<Self, Error> {
+        let vqs_info = [VirtqueueInfo::new(c"requests", false, Some(requests_done))];
+        try_pin_init!(Self {
+            index: {
+                let region = vdev.shm_region(0).ok_or(ENODEV)?;
+                // SAFETY: the region was reported by the device for this driver.
+                let index = unsafe { Index::map(region.addr, region.len) }?;
+                let h = index.header();
+                if h.magic != MAGIC {
+                    pr_err!("bad index magic {:#x} at {:#x}\n", h.magic, region.addr);
+                    return Err(EINVAL);
+                }
+                if h.version != FORMAT_VERSION {
+                    pr_err!("index format {} not supported\n", h.version);
+                    return Err(EINVAL);
+                }
+                pr_info!(
+                    "index {} MiB at {:#x}: {} slots ({} live), table {}\n",
+                    index.len >> 20,
+                    region.addr,
+                    h.entry_cap,
+                    h.live,
+                    h.table_cap
+                );
+                index
+            },
+            vqs: Vqs(vdev.find_vqs(&vqs_info)?),
+        })
+    }
+
+    fn init(&self, _vdev: &virtio::Device<Bound>) -> Result {
+        pr_info!("bound, {} virtqueue(s)\n", self.vqs.0.len());
+        Ok(())
+    }
+
+    fn remove(_vdev: &virtio::Device<Core>, _this: core::pin::Pin<&Self>) {
+        pr_info!("unbound\n");
+    }
+}
+
+kernel::virtio_device_table!(
+    SHAREDFS_TABLE,
+    MODULE_SHAREDFS_TABLE,
+    <SharedFs as virtio::Driver>::IdInfo,
+    [(virtio::DeviceId::from_raw(DEVICE_ID), ())]
+);
+
+kernel::module_virtio_driver! {
+    type: SharedFs,
+    name: "sharedfs",
+    authors: ["slomp"],
+    description: "Filesystem with host-resident metadata over virtio",
+    license: "GPL v2",
+}
