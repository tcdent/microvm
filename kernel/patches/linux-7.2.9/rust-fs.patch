+// SPDX-License-Identifier: GPL-2.0
+
+//! Slab caches for objects of one size.
+//!
+//! C headers: [`include/linux/slab.h`](srctree/include/linux/slab.h)
+
+use crate::error::{code::*, Result};
+use crate::{bindings, str::CStr, str::CStrExt};
+use core::{ffi, mem::align_of, mem::size_of, ptr::NonNull};
+
+/// A `kmem_cache` sized for `T`.
+///
+/// # Invariants
+///
+/// `ptr` is a cache returned by `__kmem_cache_create_args` that is destroyed only in `drop`.
+pub struct MemCache {
+    ptr: NonNull<bindings::kmem_cache>,
+}
+
+// SAFETY: Caches are allocated from and freed to from any thread; the C API serialises itself.
+unsafe impl Send for MemCache {}
+
+// SAFETY: See above.
+unsafe impl Sync for MemCache {}
+
+impl MemCache {
+    /// Creates a cache for objects of type `T`.
+    ///
+    /// `init` runs once when an object is first carved out of a slab, before any allocation
+    /// hands it out, and is the place for state that must survive free and reuse, such as
+    /// `inode_init_once`.
+    pub fn try_new<T>(
+        name: &'static CStr,
+        init: Option<unsafe extern "C" fn(*mut ffi::c_void)>,
+    ) -> Result<Self> {
+        let mut args: bindings::kmem_cache_args = pin_init::zeroed();
+        args.align = align_of::<T>().try_into()?;
+        args.ctor = init;
+        let flags = bindings::SLAB_RECLAIM_ACCOUNT | bindings::SLAB_ACCOUNT;
+
+        // SAFETY: `name` outlives the cache, `args` is fully initialised and only read during
+        // the call.
+        let ptr = unsafe {
+            bindings::__kmem_cache_create_args(
+                name.as_char_ptr(),
+                size_of::<T>().try_into()?,
+                &mut args,
+                flags,
+            )
+        };
+
+        // INVARIANT: The cache was just created and nothing else destroys it.
+        Ok(Self {
+            ptr: NonNull::new(ptr).ok_or(ENOMEM)?,
+        })
+    }
+
+    /// Returns the raw cache, or null when there is none.
+    pub(crate) fn ptr(c: &Option<Self>) -> *mut bindings::kmem_cache {
+        match c {
+            Some(c) => c.ptr.as_ptr(),
+            None => core::ptr::null_mut(),
+        }
+    }
+}
+
+impl Drop for MemCache {
+    fn drop(&mut self) {
+        // SAFETY: By the type invariants, `ptr` is a live cache that nothing else destroys.
+        unsafe { bindings::kmem_cache_destroy(self.ptr.as_ptr()) };
+    }
+}
