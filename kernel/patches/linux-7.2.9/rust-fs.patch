+/// The number of an inode.
+pub type Ino = u64;
+
+/// Operations implemented by inodes.
+#[vtable]
+pub trait Operations {
+    /// File system that these operations are compatible with.
+    type FileSystem: FileSystem + ?Sized;
+
+    /// Returns the path a symbolic link inode points to.
+    ///
+    /// When `dentry` is `None`, `get_link` is called with the RCU read-side lock held, so it may
+    /// not sleep. Implementations must return `Err(ECHILD)` for it to be called again without
+    /// holding the RCU lock.
+    fn get_link(
+        _dentry: Option<&DEntry<Self::FileSystem>>,
+        _inode: &INode<Self::FileSystem>,
+    ) -> Result<CString> {
+        Err(ENOTSUPP)
+    }
+
+    /// Returns the inode corresponding to the directory entry with the given name.
+    fn lookup(
+        _parent: &Locked<&INode<Self::FileSystem>, ReadSem>,
+        _dentry: dentry::Unhashed<'_, Self::FileSystem>,
+    ) -> Result<Option<ARef<DEntry<Self::FileSystem>>>> {
+        Err(ENOTSUPP)
+    }
+
+    /// Creates a regular file named by `dentry` in `parent` and returns its inode, which the
+    /// VFS binds to the dentry. `mode` carries the permission bits; `excl` is `O_EXCL`.
+    fn create(
+        _parent: &Locked<&INode<Self::FileSystem>, WriteSem>,
+        _dentry: dentry::Unhashed<'_, Self::FileSystem>,
+        _mode: u16,
+        _excl: bool,
+    ) -> Result<ARef<INode<Self::FileSystem>>> {
+        Err(ENOTSUPP)
+    }
+
+    /// Creates a directory named by `dentry` in `parent` and returns its inode.
+    fn mkdir(
+        _parent: &Locked<&INode<Self::FileSystem>, WriteSem>,
+        _dentry: dentry::Unhashed<'_, Self::FileSystem>,
+        _mode: u16,
+    ) -> Result<ARef<INode<Self::FileSystem>>> {
+        Err(ENOTSUPP)
+    }
+
+    /// Creates a symbolic link to `target` named by `dentry` in `parent` and returns its inode.
+    fn symlink(
+        _parent: &Locked<&INode<Self::FileSystem>, WriteSem>,
+        _dentry: dentry::Unhashed<'_, Self::FileSystem>,
+        _target: &CStr,
+    ) -> Result<ARef<INode<Self::FileSystem>>> {
+        Err(ENOTSUPP)
+    }
+
+    /// Gives the file `old` a further name, `dentry` in `parent`, and returns the inode to bind
+    /// to it: `old`'s own inode for a file system that tracks links per inode.
+    fn link(
+        _old: &DEntry<Self::FileSystem>,
+        _parent: &Locked<&INode<Self::FileSystem>, WriteSem>,
+        _dentry: dentry::Unhashed<'_, Self::FileSystem>,
+    ) -> Result<ARef<INode<Self::FileSystem>>> {
+        Err(ENOTSUPP)
+    }
+
+    /// Removes the name `dentry` from `parent`. The VFS drops the dentry afterwards; the
+    /// implementation accounts for the inode's lost link.
+    fn unlink(
+        _parent: &Locked<&INode<Self::FileSystem>, WriteSem>,
+        _dentry: &DEntry<Self::FileSystem>,
+    ) -> Result {
+        Err(ENOTSUPP)
+    }
+
+    /// Removes the empty directory `dentry` from `parent`.
+    fn rmdir(
+        _parent: &Locked<&INode<Self::FileSystem>, WriteSem>,
+        _dentry: &DEntry<Self::FileSystem>,
+    ) -> Result {
+        Err(ENOTSUPP)
+    }
+
+    /// Moves `old` in `old_parent` to the name `new` in `new_parent`, replacing whatever `new`
+    /// names. Both directories are locked; when they are the same directory, both arguments
+    /// refer to it. `flags` are the `RENAME_*` flags, which the implementation must check.
+    fn rename(
+        _old_parent: &Locked<&INode<Self::FileSystem>, WriteSem>,
+        _old: &DEntry<Self::FileSystem>,
+        _new_parent: &Locked<&INode<Self::FileSystem>, WriteSem>,
+        _new: &DEntry<Self::FileSystem>,
+        _flags: u32,
+    ) -> Result {
+        Err(ENOTSUPP)
+    }
+
+    /// Changes the attributes of `inode`, named by `dentry`, to those in `attr`. Permission
+    /// checks have been done; a size change also means truncating or extending the contents.
+    fn setattr(
+        _dentry: &DEntry<Self::FileSystem>,
+        _inode: &Locked<&INode<Self::FileSystem>, WriteSem>,
+        _attr: &SetAttr,
+    ) -> Result {
+        Err(ENOTSUPP)
+    }
+}
+
+/// The attribute changes a `setattr` call asks for.
+///
+/// Wraps the kernel's `struct iattr`: each accessor returns `Some` only for an attribute the
+/// caller is changing. Times are as the VFS filled them in, so a `touch` reads as the current
+/// time.
+#[repr(transparent)]
+pub struct SetAttr(Opaque<bindings::iattr>);
+
+impl SetAttr {
+    /// # Safety
+    ///
+    /// `ptr` must be valid for the lifetime of the returned reference.
+    unsafe fn from_raw<'a>(ptr: *mut bindings::iattr) -> &'a Self {
+        // SAFETY: Per the safety requirements; `SetAttr` is a transparent wrapper.
+        unsafe { &*ptr.cast() }
+    }
+
+    fn raw(&self) -> &bindings::iattr {
+        // SAFETY: The wrapped struct is valid and only read while this reference lives.
+        unsafe { &*self.0.get() }
+    }
+
+    fn has(&self, bit: u32) -> bool {
+        self.raw().ia_valid & bit != 0
+    }
+
+    /// The `ATTR_*` bits of the change.
+    pub fn valid(&self) -> u32 {
+        self.raw().ia_valid
+    }
+
+    /// New permission bits, type bits excluded.
+    pub fn mode(&self) -> Option<u16> {
+        self.has(bindings::ATTR_MODE).then(|| self.raw().ia_mode & 0o7777)
+    }
+
+    /// New owner.
+    pub fn uid(&self) -> Option<u32> {
+        // SAFETY: Both halves of the union hold the same value.
+        self.has(bindings::ATTR_UID).then(|| unsafe { self.raw().__bindgen_anon_1.ia_uid.val })
+    }
+
+    /// New group.
+    pub fn gid(&self) -> Option<u32> {
+        // SAFETY: Both halves of the union hold the same value.
+        self.has(bindings::ATTR_GID).then(|| unsafe { self.raw().__bindgen_anon_2.ia_gid.val })
+    }
+
+    /// New size.
+    pub fn size(&self) -> Option<Offset> {
+        self.has(bindings::ATTR_SIZE).then(|| self.raw().ia_size)
+    }
+
+    /// New access time.
+    pub fn atime(&self) -> Option<Timespec> {
+        self.has(bindings::ATTR_ATIME).then(|| ts(&self.raw().ia_atime))
+    }
+
+    /// New modification time.
+    pub fn mtime(&self) -> Option<Timespec> {
+        self.has(bindings::ATTR_MTIME).then(|| ts(&self.raw().ia_mtime))
+    }
+
+    /// The change time the VFS assigned to this change.
+    pub fn ctime(&self) -> Timespec {
+        ts(&self.raw().ia_ctime)
+    }
+
+    /// Applies the change to `inode` itself, as a file system without a backing store would:
+    /// `setattr_copy` for mode, owner and times, and the new size.
+    pub fn apply_to<T: FileSystem + ?Sized>(&self, inode: &INode<T>) {
+        // SAFETY: Both are valid; `nop_mnt_idmap` is a static the kernel never frees, and this
+        // is what `simple_setattr` does.
+        unsafe {
+            bindings::setattr_copy(
+                ptr::addr_of_mut!(bindings::nop_mnt_idmap),
+                inode.0.get(),
+                self.0.get(),
+            )
+        };
+        if let Some(size) = self.size() {
+            inode.set_size(size);
+        }
+    }
+}
+
+fn ts(t: &bindings::timespec64) -> Timespec {
+    Timespec {
+        sec: t.tv_sec,
+        nsec: u32::try_from(t.tv_nsec).unwrap_or(0),
+    }
+}
