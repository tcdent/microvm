diff -ruN a/rust/kernel/folio.rs b/rust/kernel/folio.rs
--- a/rust/kernel/folio.rs	1969-12-31 16:00:00.000000000 -0800
+++ b/rust/kernel/folio.rs	2026-11-23 14:31:42.767575249 -0800
@@ -0,0 +1,195 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! Folios: groups of contiguous pages.
+//!
+//! C headers: [`include/linux/mm.h`](srctree/include/linux/mm.h)
+
+use crate::error::{code::*, Result};
+use crate::fs::{self, inode::INode, FileSystem};
+use crate::page::BorrowedPage;
+use crate::sync::aref::AlwaysRefCounted;
+use crate::sync::{Lockable, Locked};
+use crate::types::{Opaque, ScopeGuard};
+use core::{cmp::min, marker::PhantomData, ops::Deref, ptr};
+
+/// The kind of a [`Folio`] is unspecified.
+pub struct Unspecified;
+
+/// The [`Folio`] belongs to the page cache of a file system of type `T`.
+pub struct PageCache<T: FileSystem + ?Sized>(PhantomData<T>);
+
+/// A folio.
+///
+/// Wraps the kernel's `struct folio`. `S` says what kind of folio this is.
+///
+/// # Invariants
+///
+/// Instances are always ref-counted: a call to `folio_get` keeps the allocation valid at least
+/// until the matching `folio_put`.
+#[repr(transparent)]
+pub struct Folio<S = Unspecified>(pub(crate) Opaque<bindings::folio>, PhantomData<S>);
+
+// SAFETY: The type invariants guarantee that `Folio` is always ref-counted.
+unsafe impl<S> AlwaysRefCounted for Folio<S> {
+    fn inc_ref(&self) {
+        // SAFETY: The existence of a shared reference means that the refcount is nonzero.
+        unsafe { bindings::folio_get(self.0.get()) };
+    }
+
+    unsafe fn dec_ref(obj: ptr::NonNull<Self>) {
+        // SAFETY: The safety requirements guarantee that the refcount is nonzero.
+        unsafe { bindings::folio_put(obj.as_ref().0.get()) }
+    }
+}
+
+impl<S> Folio<S> {
+    /// Creates a folio reference from a raw pointer.
+    ///
+    /// # Safety
+    ///
+    /// Callers must ensure that:
+    /// * `ptr` is valid and remains so for the lifetime of the returned reference.
+    /// * The folio is of kind `S`.
+    pub(crate) unsafe fn from_raw<'a>(ptr: *mut bindings::folio) -> &'a Self {
+        // SAFETY: The safety requirements guarantee that the cast below is ok.
+        unsafe { &*ptr.cast::<Self>() }
+    }
+
+    /// Returns the byte position of this folio in its file.
+    pub fn pos(&self) -> fs::Offset {
+        // SAFETY: The folio is valid because the shared reference implies a non-zero refcount.
+        unsafe { bindings::folio_pos(self.0.get()) }
+    }
+
+    /// Returns the byte size of this folio.
+    pub fn size(&self) -> usize {
+        // SAFETY: The folio is valid because the shared reference implies a non-zero refcount.
+        unsafe { bindings::folio_size(self.0.get()) }
+    }
+
+    /// Returns the first page of the folio.
+    ///
+    /// The pages of a folio are physically contiguous, so this page and [`Folio::size`] describe
+    /// the whole folio for callers that hand it to a device.
+    pub fn first_page(&self) -> BorrowedPage<'_> {
+        // SAFETY: The folio is valid and index 0 is always within it.
+        let page = unsafe { bindings::folio_page(self.0.get(), 0) };
+        // SAFETY: The page is part of the folio, which outlives the returned borrow.
+        unsafe { BorrowedPage::from_raw(ptr::NonNull::new_unchecked(page)) }
+    }
+
+    /// Flushes the data cache for the pages that make up the folio.
+    pub fn flush_dcache(&self) {
+        // SAFETY: The folio is valid because the shared reference implies a non-zero refcount.
+        unsafe { bindings::flush_dcache_folio(self.0.get()) }
+    }
+
+    /// Returns true if the folio is in highmem.
+    pub fn test_highmem(&self) -> bool {
+        // SAFETY: The folio is valid because the shared reference implies a non-zero refcount.
+        unsafe { bindings::folio_test_highmem(self.0.get()) }
+    }
+
+    /// Returns whether the folio is up to date.
+    pub fn test_uptodate(&self) -> bool {
+        // SAFETY: The folio is valid because the shared reference implies a non-zero refcount.
+        unsafe { bindings::folio_test_uptodate(self.0.get()) }
+    }
+}
+
+impl<T: FileSystem + ?Sized> Folio<PageCache<T>> {
+    /// Returns the inode whose data this folio holds.
+    pub fn inode(&self) -> &INode<T> {
+        // SAFETY: The type parameter guarantees that this is a page-cache folio, so `mapping`
+        // and its host are populated and outlive the folio.
+        unsafe {
+            INode::from_raw((*(*self.0.get()).__bindgen_anon_1.__bindgen_anon_1.mapping).host)
+        }
+    }
+}
+
+// SAFETY: `raw_lock` calls `folio_lock`, which locks the folio.
+unsafe impl<S> Lockable for Folio<S> {
+    fn raw_lock(&self) {
+        // SAFETY: The folio is valid because the shared reference implies a non-zero refcount.
+        unsafe { bindings::folio_lock(self.0.get()) }
+    }
+
+    unsafe fn unlock(&self) {
+        // SAFETY: The safety requirements guarantee that the folio is locked.
+        unsafe { bindings::folio_unlock(self.0.get()) }
+    }
+}
+
+impl<T: Deref<Target = Folio<S>>, S> Locked<T> {
+    /// Marks the folio as being up to date.
+    pub fn mark_uptodate(&mut self) {
+        // SAFETY: The folio is valid because the shared reference implies a non-zero refcount.
+        unsafe { bindings::folio_mark_uptodate(self.deref().0.get()) }
+    }
+
+    /// Runs `cb` over `len` bytes of the folio starting at `offset`, one mapping at a time.
+    ///
+    /// A folio in highmem is mapped one page at a time, so `cb` may run more than once.
+    fn for_each_page(
+        &mut self,
+        offset: usize,
+        len: usize,
+        mut cb: impl FnMut(&mut [u8]) -> Result,
+    ) -> Result {
+        let mut remaining = len;
+        let mut next_offset = offset;
+
+        if self.test_uptodate() {
+            return Err(EIO);
+        }
+
+        let end = offset.checked_add(len).ok_or(EDOM)?;
+        if end > self.deref().size() {
+            return Err(EINVAL);
+        }
+
+        while remaining > 0 {
+            let map_size = if self.test_highmem() {
+                bindings::PAGE_SIZE - (next_offset & (bindings::PAGE_SIZE - 1))
+            } else {
+                self.size() - next_offset
+            };
+            let usable = min(remaining, map_size);
+            // SAFETY: The folio is valid and `next_offset` is less than its size.
+            let ptr = unsafe { bindings::kmap_local_folio(self.deref().0.get(), next_offset) };
+
+            // SAFETY: `ptr` was just returned by `kmap_local_folio` above.
+            let _guard = ScopeGuard::new(|| unsafe { bindings::kunmap_local(ptr) });
+
+            // SAFETY: `kmap_local_folio` maps at least to the end of the page, which covers
+            // `usable` bytes. The folio is locked and not up to date, so nothing else reads it.
+            let s = unsafe { core::slice::from_raw_parts_mut(ptr.cast::<u8>(), usable) };
+            cb(s)?;
+
+            next_offset += usable;
+            remaining -= usable;
+        }
+
+        Ok(())
+    }
+
+    /// Writes the given slice into the folio.
+    pub fn write(&mut self, offset: usize, data: &[u8]) -> Result {
+        let mut remaining = data;
+
+        self.for_each_page(offset, data.len(), |s| {
+            s.copy_from_slice(&remaining[..s.len()]);
+            remaining = &remaining[s.len()..];
+            Ok(())
+        })
+    }
+
+    /// Writes zeroes into the folio.
+    pub fn zero_out(&mut self, offset: usize, len: usize) -> Result {
+        self.for_each_page(offset, len, |s| {
+            s.fill(0);
+            Ok(())
+        })
+    }
+}
diff -ruN a/rust/kernel/fs/address_space.rs b/rust/kernel/fs/address_space.rs
--- a/rust/kernel/fs/address_space.rs	1969-12-31 16:00:00.000000000 -0800
+++ b/rust/kernel/fs/address_space.rs	2026-11-23 14:31:42.851576545 -0800
@@ -0,0 +1,86 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! File system address spaces.
+//!
+//! This module allows Rust code implement address space operations.
+//!
+//! C headers: [`include/linux/fs.h`](srctree/include/linux/fs.h)
+
+use super::{file::File, FileSystem};
+use crate::error::{from_result, Result};
+use crate::sync::Locked;
+use crate::{bindings, folio::Folio, folio::PageCache};
+use core::marker::PhantomData;
+use macros::vtable;
+
+/// Operations implemented by address spaces.
+#[vtable]
+pub trait Operations {
+    /// File system that these operations are compatible with.
+    type FileSystem: FileSystem + ?Sized;
+
+    /// Reads the contents of the inode into the given folio.
+    ///
+    /// The folio arrives locked and not up to date. Implementations fill it, mark it up to date
+    /// and return; the lock is released when the guard is dropped.
+    fn read_folio(file: Option<&File>, folio: Locked<&Folio<PageCache<Self::FileSystem>>>) -> Result;
+}
+
+/// Represents address space operations.
+pub struct Ops<T: FileSystem + ?Sized>(
+    pub(crate) *const bindings::address_space_operations,
+    pub(crate) PhantomData<T>,
+);
+
+impl<T: FileSystem + ?Sized> Ops<T> {
+    /// Address space operations for a DAX inode: nothing is ever cached or written back here,
+    /// so the only operations are the no-ops the VFS still expects to find.
+    pub const fn dax() -> Self {
+        const TABLE: bindings::address_space_operations = bindings::address_space_operations {
+            direct_IO: Some(bindings::noop_direct_IO),
+            dirty_folio: Some(bindings::noop_dirty_folio),
+            ..pin_init::zeroed()
+        };
+        Self(&TABLE, PhantomData)
+    }
+
+    /// Creates the address space operations from a type that implements the [`Operations`] trait.
+    pub const fn new<U: Operations<FileSystem = T> + ?Sized>() -> Self {
+        struct Table<T: Operations + ?Sized>(PhantomData<T>);
+        impl<T: Operations + ?Sized> Table<T> {
+            const TABLE: bindings::address_space_operations = bindings::address_space_operations {
+                read_folio: if T::HAS_READ_FOLIO {
+                    Some(Self::read_folio_callback)
+                } else {
+                    None
+                },
+                ..pin_init::zeroed()
+            };
+
+            unsafe extern "C" fn read_folio_callback(
+                file_ptr: *mut bindings::file,
+                folio_ptr: *mut bindings::folio,
+            ) -> i32 {
+                from_result(|| {
+                    let file = if file_ptr.is_null() {
+                        None
+                    } else {
+                        // SAFETY: The C API guarantees that `file_ptr` is a valid file if non-null,
+                        // and that it stays valid for the duration of the callback.
+                        Some(unsafe { File::from_raw_file(file_ptr) })
+                    };
+
+                    // SAFETY: The C API guarantees that `folio_ptr` is a valid page-cache folio of
+                    // this file system.
+                    let folio = unsafe { Folio::from_raw(folio_ptr) };
+
+                    // SAFETY: The C contract guarantees that the folio is valid and locked, with
+                    // ownership of the lock transferred to the callee (this function).
+                    T::read_folio(file, unsafe { Locked::new(folio) })?;
+                    Ok(0)
+                })
+            }
+        }
+        Self(&Table::<U>::TABLE, PhantomData)
+    }
+}
diff -ruN a/rust/kernel/fs/dax.rs b/rust/kernel/fs/dax.rs
--- a/rust/kernel/fs/dax.rs	1969-12-31 16:00:00.000000000 -0800
+++ b/rust/kernel/fs/dax.rs	2026-11-23 14:31:42.887577100 -0800
@@ -0,0 +1,474 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! Direct access to file data that lives at physical addresses outside the page cache.
+//!
+//! A file system whose data sits in a physical window, device memory or memory a hypervisor
+//! shares with the guest, describes the window once, answers each `iomap_begin` with "this
+//! range of this file is at that window offset", and the kernel's DAX code does `read`, `write`,
+//! `mmap` and page faults in place. Nothing is copied into a page cache.
+//!
+//! C headers: [`include/linux/dax.h`](srctree/include/linux/dax.h),
+//! [`include/linux/iomap.h`](srctree/include/linux/iomap.h),
+//! [`include/linux/memremap.h`](srctree/include/linux/memremap.h)
+
+use super::{file::File, inode::INode, FileSystem, Kiocb, Offset};
+use crate::alloc::{flags::GFP_KERNEL, KBox};
+use crate::error::{code::*, from_err_ptr, from_result, Error, Result};
+use crate::iov::{IovIterDest, IovIterSource};
+use crate::mm::virt::VmaNew;
+use crate::{bindings, ffi};
+use core::{marker::PhantomData, ptr, ptr::NonNull};
+use macros::vtable;
+
+/// A physical range given `struct page`s so DAX can map it: ZONE_DEVICE memory of type
+/// `MEMORY_DEVICE_FS_DAX`, with a kernel mapping.
+///
+/// # Invariants
+///
+/// `kaddr` maps `len` bytes starting at physical address `phys` for as long as the window lives.
+pub struct Window {
+    pgmap: KBox<bindings::dev_pagemap>,
+    kaddr: NonNull<u8>,
+    phys: u64,
+    len: u64,
+}
+
+// SAFETY: The window holds no thread-affine state; the pages it describes are shared memory.
+unsafe impl Send for Window {}
+// SAFETY: See above.
+unsafe impl Sync for Window {}
+
+impl Window {
+    /// Gives the physical range `phys..phys + len` pages and a kernel mapping.
+    ///
+    /// Each 4 KiB page costs a `struct page`, so an 8 GiB window costs 128 MiB of memory.
+    ///
+    /// # Safety
+    ///
+    /// The range must be memory the caller owns for the window's lifetime, page aligned and
+    /// not otherwise in use by the kernel.
+    pub unsafe fn new(phys: u64, len: u64) -> Result<Self> {
+        if len == 0 || phys % bindings::PAGE_SIZE as u64 != 0 || len % bindings::PAGE_SIZE as u64 != 0 {
+            return Err(EINVAL);
+        }
+        let mut pgmap = KBox::<bindings::dev_pagemap>::new_uninit(GFP_KERNEL)?;
+        // SAFETY: `dev_pagemap` is a plain C struct for which all-zero is the documented initial
+        // state before the fields below are set.
+        let mut pgmap = unsafe {
+            pgmap.as_mut_ptr().write_bytes(0, 1);
+            pgmap.assume_init()
+        };
+        pgmap.type_ = bindings::memory_type_MEMORY_DEVICE_FS_DAX;
+        pgmap.nr_range = 1;
+        // SAFETY: `range` is the active member of the union for a one-range pagemap.
+        unsafe {
+            *pgmap.__bindgen_anon_1.range.as_mut() = bindings::range {
+                start: phys,
+                end: phys + len - 1,
+            }
+        };
+        // SAFETY: `pgmap` is fully initialised and pinned by its box for the window's lifetime.
+        let kaddr = from_err_ptr(unsafe { bindings::memremap_pages(&mut *pgmap, bindings::NUMA_NO_NODE) })?;
+        // INVARIANT: `memremap_pages` mapped exactly this range.
+        Ok(Self {
+            pgmap,
+            kaddr: NonNull::new(kaddr.cast()).ok_or(ENOMEM)?,
+            phys,
+            len,
+        })
+    }
+
+    /// Kernel virtual address of the start of the window.
+    pub fn kaddr(&self) -> *mut u8 {
+        self.kaddr.as_ptr()
+    }
+
+    /// Physical address of the start of the window.
+    pub fn phys(&self) -> u64 {
+        self.phys
+    }
+
+    /// Size of the window in bytes.
+    pub fn len(&self) -> u64 {
+        self.len
+    }
+}
+
+impl Drop for Window {
+    fn drop(&mut self) {
+        // SAFETY: `pgmap` is the one `memremap_pages` set up and nothing maps the range anymore.
+        unsafe { bindings::memunmap_pages(&mut *self.pgmap) };
+    }
+}
+
+/// A DAX device whose whole address space is one [`Window`].
+///
+/// # Invariants
+///
+/// `dev` is a live `dax_device` whose private data points at `*window`, which the box keeps at a
+/// fixed address for as long as the device exists.
+pub struct Device {
+    dev: NonNull<bindings::dax_device>,
+    window: KBox<Window>,
+}
+
+// SAFETY: The device is only used through the kernel's DAX API, which is thread safe.
+unsafe impl Send for Device {}
+// SAFETY: See above.
+unsafe impl Sync for Device {}
+
+impl Device {
+    /// Creates a DAX device over `window`, taking ownership of it.
+    pub fn new(window: Window) -> Result<Self> {
+        let window = KBox::new(window, GFP_KERNEL)?;
+        // SAFETY: The table is static, and the private pointer is the boxed window, which does
+        // not move and is dropped only after the device in `drop`.
+        let dev = from_err_ptr(unsafe {
+            bindings::alloc_dax(ptr::from_ref(&*window).cast_mut().cast(), &Self::OPS)
+        })?;
+        // INVARIANT: `alloc_dax` returned a live device with our private data.
+        Ok(Self {
+            dev: NonNull::new(dev).ok_or(ENOMEM)?,
+            window,
+        })
+    }
+
+    /// The window this device covers.
+    pub fn window(&self) -> &Window {
+        &self.window
+    }
+
+    const OPS: bindings::dax_operations = bindings::dax_operations {
+        direct_access: Some(Self::direct_access),
+        zero_page_range: Some(Self::zero_page_range),
+        recovery_write: None,
+    };
+
+    /// Returns the window a device was created over.
+    ///
+    /// # Safety
+    ///
+    /// `dax_dev` must be a device created by [`Device::new`] whose window is still alive.
+    unsafe fn window_of<'a>(dax_dev: *mut bindings::dax_device) -> &'a Window {
+        // SAFETY: Per the caller, the private data is the window passed to `new`.
+        unsafe { &*bindings::dax_get_private(dax_dev).cast::<Window>() }
+    }
+
+    unsafe extern "C" fn direct_access(
+        dax_dev: *mut bindings::dax_device,
+        pgoff: ffi::c_ulong,
+        nr_pages: ffi::c_long,
+        _mode: bindings::dax_access_mode,
+        kaddr: *mut *mut ffi::c_void,
+        pfn: *mut ffi::c_ulong,
+    ) -> ffi::c_long {
+        // SAFETY: The DAX core only calls this on devices made by `new`.
+        let w = unsafe { Self::window_of(dax_dev) };
+        let offset = (pgoff as u64) << bindings::PAGE_SHIFT;
+        if offset >= w.len {
+            return -(ERANGE.to_errno() as ffi::c_long);
+        }
+        let avail = ((w.len - offset) >> bindings::PAGE_SHIFT) as ffi::c_long;
+        if !kaddr.is_null() {
+            // SAFETY: The caller provided a place to store the address.
+            unsafe { *kaddr = w.kaddr().add(offset as usize).cast() };
+        }
+        if !pfn.is_null() {
+            // SAFETY: The caller provided a place to store the frame number.
+            unsafe { *pfn = ((w.phys + offset) >> bindings::PAGE_SHIFT) as ffi::c_ulong };
+        }
+        nr_pages.min(avail)
+    }
+
+    unsafe extern "C" fn zero_page_range(
+        dax_dev: *mut bindings::dax_device,
+        pgoff: ffi::c_ulong,
+        nr_pages: usize,
+    ) -> ffi::c_int {
+        // SAFETY: The DAX core only calls this on devices made by `new`.
+        let w = unsafe { Self::window_of(dax_dev) };
+        let offset = (pgoff as u64) << bindings::PAGE_SHIFT;
+        let len = (nr_pages as u64) << bindings::PAGE_SHIFT;
+        if offset.checked_add(len).is_none_or(|end| end > w.len) {
+            return -ERANGE.to_errno();
+        }
+        // SAFETY: The range is inside the window's kernel mapping.
+        unsafe { w.kaddr().add(offset as usize).write_bytes(0, len as usize) };
+        0
+    }
+}
+
+impl Drop for Device {
+    fn drop(&mut self) {
+        // SAFETY: By the type invariants, `dev` is live and ours. The window is dropped after
+        // this, as the struct's field order says.
+        unsafe {
+            bindings::kill_dax(self.dev.as_ptr());
+            bindings::put_dax(self.dev.as_ptr());
+        }
+    }
+}
+
+/// `iomap_begin` flags.
+pub mod flags {
+    /// The range is about to be written.
+    pub const WRITE: u32 = bindings::IOMAP_WRITE;
+    /// The range is about to be zeroed.
+    pub const ZERO: u32 = bindings::IOMAP_ZERO;
+    /// The caller is a page fault and must not sleep on reclaim.
+    pub const FAULT: u32 = bindings::IOMAP_FAULT;
+    /// The caller only wants to know what is there (FIEMAP).
+    pub const REPORT: u32 = bindings::IOMAP_REPORT;
+}
+
+/// What a file system says about a range of a file.
+pub enum Extent<'a> {
+    /// Nothing is there; reads see zeros.
+    Hole {
+        /// Bytes of hole from the requested position.
+        length: Offset,
+    },
+    /// The range is in the window.
+    Mapped {
+        /// The device the window belongs to.
+        device: &'a Device,
+        /// Byte offset in the window of the requested position.
+        window_offset: u64,
+        /// Bytes mapped from the requested position.
+        length: Offset,
+        /// Handed back to [`Operations::end`] unchanged.
+        private: usize,
+    },
+}
+
+/// How a file system maps file ranges onto its window.
+#[vtable]
+pub trait Operations {
+    /// File system that these operations are compatible with.
+    type FileSystem: FileSystem + ?Sized;
+
+    /// Describes the range of `length` bytes at `pos`, or as much of its start as is contiguous.
+    fn begin(
+        inode: &INode<Self::FileSystem>,
+        pos: Offset,
+        length: Offset,
+        flags: u32,
+    ) -> Result<Extent<'_>>;
+
+    /// Called once the kernel is done with an extent [`Operations::begin`] returned.
+    fn end(
+        _inode: &INode<Self::FileSystem>,
+        _pos: Offset,
+        _length: Offset,
+        _written: isize,
+        _flags: u32,
+        _private: usize,
+    ) {
+    }
+}
+
+/// The `iomap_ops` table for an [`Operations`] implementation.
+pub struct Ops<T: FileSystem + ?Sized>(*const bindings::iomap_ops, PhantomData<T>);
+
+impl<T: FileSystem + ?Sized> Ops<T> {
+    /// Creates the table from a type that implements [`Operations`].
+    pub const fn new<U: Operations<FileSystem = T> + ?Sized>() -> Self {
+        Self(&Table::<U>::TABLE, PhantomData)
+    }
+}
+
+struct Table<U: Operations + ?Sized>(PhantomData<U>);
+
+impl<U: Operations + ?Sized> Table<U> {
+    const TABLE: bindings::iomap_ops = bindings::iomap_ops {
+        iomap_begin: Some(Self::begin),
+        iomap_end: Some(Self::end),
+        iomap_next: None,
+    };
+
+    const VM_OPS: bindings::vm_operations_struct = bindings::vm_operations_struct {
+        fault: Some(Self::fault),
+        huge_fault: Some(Self::huge_fault),
+        page_mkwrite: Some(Self::mkwrite),
+        pfn_mkwrite: Some(Self::mkwrite),
+        ..pin_init::zeroed()
+    };
+
+    unsafe extern "C" fn begin(
+        inode: *mut bindings::inode,
+        pos: bindings::loff_t,
+        length: bindings::loff_t,
+        flags: ffi::c_uint,
+        iomap: *mut bindings::iomap,
+        _srcmap: *mut bindings::iomap,
+    ) -> ffi::c_int {
+        from_result(|| {
+            // SAFETY: The iomap core passes a valid inode of this file system and a valid iomap.
+            let inode = unsafe { INode::from_raw(inode) };
+            let m = unsafe { &mut *iomap };
+            m.offset = pos;
+            m.flags = 0;
+            m.bdev = ptr::null_mut();
+            m.dax_dev = ptr::null_mut();
+            m.private = ptr::null_mut();
+            match U::begin(inode, pos, length, flags)? {
+                Extent::Hole { length } => {
+                    m.addr = u64::MAX;
+                    m.length = length as u64;
+                    m.type_ = bindings::IOMAP_HOLE as u16;
+                }
+                Extent::Mapped {
+                    device,
+                    window_offset,
+                    length,
+                    private,
+                } => {
+                    m.addr = window_offset;
+                    m.length = length as u64;
+                    m.type_ = bindings::IOMAP_MAPPED as u16;
+                    m.dax_dev = device.dev.as_ptr();
+                    m.private = private as *mut ffi::c_void;
+                }
+            }
+            Ok(0)
+        })
+    }
+
+    unsafe extern "C" fn end(
+        inode: *mut bindings::inode,
+        pos: bindings::loff_t,
+        length: bindings::loff_t,
+        written: isize,
+        flags: ffi::c_uint,
+        iomap: *mut bindings::iomap,
+    ) -> ffi::c_int {
+        // SAFETY: The iomap core passes a valid inode of this file system and the iomap `begin`
+        // filled in.
+        let inode = unsafe { INode::from_raw(inode) };
+        let private = unsafe { (*iomap).private } as usize;
+        U::end(inode, pos, length, written, flags, private);
+        0
+    }
+
+    /// Serves a fault the way `fuse_dax_fault` does: under the mapping's invalidate lock, so
+    /// nothing reclaims the range meanwhile, retrying while `begin` reports `EAGAIN`.
+    fn serve_fault(vmf: *mut bindings::vm_fault, order: u32, write: bool) -> bindings::vm_fault_t {
+        // SAFETY: The fault core passes a valid `vm_fault` whose vma has a file.
+        let (sb, mapping) = unsafe {
+            let inode = (*(*(*vmf).__bindgen_anon_1.vma).vm_file).f_inode;
+            ((*inode).i_sb, (*inode).i_mapping)
+        };
+        if write {
+            // SAFETY: `sb` is the live superblock of the faulting file.
+            unsafe { bindings::sb_start_pagefault(sb) };
+        }
+        let ret = loop {
+            let mut pfn: ffi::c_ulong = 0;
+            let mut err: ffi::c_int = 0;
+            // SAFETY: `mapping` is valid; the lock is released below on every path.
+            unsafe { bindings::filemap_invalidate_lock_shared(mapping) };
+            // SAFETY: `vmf` is valid and the table outlives every mapping that uses it.
+            let ret = unsafe { bindings::dax_iomap_fault(vmf, order, &mut pfn, &mut err, &Self::TABLE) };
+            // SAFETY: Taken above.
+            unsafe { bindings::filemap_invalidate_unlock_shared(mapping) };
+            // `to_errno` is already negative, as `err` is.
+            if ret & VM_FAULT_ERROR != 0 && err == EAGAIN.to_errno() {
+                // The window is full and a fault cannot reclaim: give reclaim a moment.
+                // SAFETY: Process context; sleeping is allowed in a fault handler.
+                unsafe { bindings::msleep(1) };
+                continue;
+            }
+            break ret;
+        };
+        if write {
+            // SAFETY: Matches the `sb_start_pagefault` above.
+            unsafe { bindings::sb_end_pagefault(sb) };
+        }
+        ret
+    }
+
+    unsafe extern "C" fn fault(vmf: *mut bindings::vm_fault) -> bindings::vm_fault_t {
+        // SAFETY: The fault core passes a valid `vm_fault`.
+        let write = unsafe { (*vmf).flags } & bindings::fault_flag_FAULT_FLAG_WRITE != 0;
+        Self::serve_fault(vmf, 0, write)
+    }
+
+    unsafe extern "C" fn huge_fault(vmf: *mut bindings::vm_fault, order: ffi::c_uint) -> bindings::vm_fault_t {
+        // SAFETY: The fault core passes a valid `vm_fault`.
+        let write = unsafe { (*vmf).flags } & bindings::fault_flag_FAULT_FLAG_WRITE != 0;
+        Self::serve_fault(vmf, order, write)
+    }
+
+    unsafe extern "C" fn mkwrite(vmf: *mut bindings::vm_fault) -> bindings::vm_fault_t {
+        Self::serve_fault(vmf, 0, true)
+    }
+}
+
+const VM_FAULT_ERROR: bindings::vm_fault_t = bindings::vm_fault_reason_VM_FAULT_OOM
+    | bindings::vm_fault_reason_VM_FAULT_SIGBUS
+    | bindings::vm_fault_reason_VM_FAULT_HWPOISON
+    | bindings::vm_fault_reason_VM_FAULT_HWPOISON_LARGE
+    | bindings::vm_fault_reason_VM_FAULT_FALLBACK;
+
+/// Makes sure no process has the range `start..=end` of `inode` mapped and no DAX entries for
+/// it remain, waiting for in-flight users of the pages. Afterwards the window range behind it
+/// may be reused. Takes the mapping's invalidate lock for the duration.
+pub fn break_layout<T: FileSystem + ?Sized>(inode: &INode<T>, start: Offset, end: Offset) -> Result {
+    unsafe extern "C" fn wait(inode: *mut bindings::inode) {
+        // SAFETY: Called by `dax_break_layout` with the inode whose invalidate lock we hold; let
+        // others make progress and take it back, as `fuse_wait_dax_page` does.
+        unsafe {
+            bindings::filemap_invalidate_unlock((*inode).i_mapping);
+            bindings::schedule();
+            bindings::filemap_invalidate_lock((*inode).i_mapping);
+        }
+    }
+    let raw = inode.0.get();
+    // SAFETY: The inode is valid; the lock is released on both paths below.
+    unsafe {
+        bindings::filemap_invalidate_lock((*raw).i_mapping);
+        let ret = bindings::dax_break_layout(raw, start, end, Some(wait));
+        bindings::filemap_invalidate_unlock((*raw).i_mapping);
+        crate::error::to_result(ret)
+    }
+}
+
+/// Reads from a DAX file into `iter`, as `dax_iomap_rw` does. The caller holds the inode lock
+/// at least shared.
+pub fn read<T: FileSystem + ?Sized>(
+    iocb: &mut Kiocb<'_, ()>,
+    iter: &mut IovIterDest<'_>,
+    ops: &Ops<T>,
+) -> Result<usize> {
+    // SAFETY: Both pointers are live for the call and the table is static.
+    let n = unsafe { bindings::dax_iomap_rw(iocb.as_raw(), iter.as_raw(), ops.0) };
+    if n < 0 {
+        Err(Error::from_errno(n as ffi::c_int))
+    } else {
+        Ok(n as usize)
+    }
+}
+
+/// Writes `iter` into a DAX file, as `dax_iomap_rw` does. The caller holds the inode lock
+/// exclusively and has already made sure the file extends far enough.
+pub fn write<T: FileSystem + ?Sized>(
+    iocb: &mut Kiocb<'_, ()>,
+    iter: &mut IovIterSource<'_>,
+    ops: &Ops<T>,
+) -> Result<usize> {
+    // SAFETY: Both pointers are live for the call and the table is static.
+    let n = unsafe { bindings::dax_iomap_rw(iocb.as_raw(), iter.as_raw(), ops.0) };
+    if n < 0 {
+        Err(Error::from_errno(n as ffi::c_int))
+    } else {
+        Ok(n as usize)
+    }
+}
+
+/// Sets a new VMA up so its faults are served from the window through `U`.
+pub fn mmap<U: Operations + ?Sized>(file: &File, vma: &VmaNew) {
+    // SAFETY: The file is valid for the call.
+    unsafe { bindings::file_accessed(file.as_ptr()) };
+    vma.set_ops(&Table::<U>::VM_OPS);
+    vma.set_mixedmap();
+}
diff -ruN a/rust/kernel/fs/dentry.rs b/rust/kernel/fs/dentry.rs
--- a/rust/kernel/fs/dentry.rs	1969-12-31 16:00:00.000000000 -0800
+++ b/rust/kernel/fs/dentry.rs	2026-11-23 14:31:42.923577655 -0800
@@ -0,0 +1,247 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! File system directory entries.
+//!
+//! This module allows Rust code to use dentries.
+//!
+//! C headers: [`include/linux/dcache.h`](srctree/include/linux/dcache.h)
+
+use super::{inode::INode, FileSystem, SuperBlock};
+use crate::bindings;
+use crate::error::{code::*, from_err_ptr, from_result, Result};
+use crate::sync::aref::{ARef, AlwaysRefCounted};
+use crate::types::Opaque;
+use core::{marker::PhantomData, mem::ManuallyDrop, ops::Deref, ptr};
+use macros::vtable;
+
+/// A directory entry.
+///
+/// Wraps the kernel's `struct dentry`.
+///
+/// # Invariants
+///
+/// Instances of this type are always ref-counted, that is, a call to `dget` ensures that the
+/// allocation remains valid at least until the matching call to `dput`.
+#[repr(transparent)]
+pub struct DEntry<T: FileSystem + ?Sized>(pub(crate) Opaque<bindings::dentry>, PhantomData<T>);
+
+// SAFETY: The type invariants guarantee that `DEntry` is always ref-counted.
+unsafe impl<T: FileSystem + ?Sized> AlwaysRefCounted for DEntry<T> {
+    fn inc_ref(&self) {
+        // SAFETY: The existence of a shared reference means that the refcount is nonzero.
+        unsafe { bindings::dget(self.0.get()) };
+    }
+
+    unsafe fn dec_ref(obj: ptr::NonNull<Self>) {
+        // SAFETY: The safety requirements guarantee that the refcount is nonzero.
+        unsafe { bindings::dput(obj.as_ref().0.get()) }
+    }
+}
+
+impl<T: FileSystem + ?Sized> DEntry<T> {
+    /// Creates a new [`DEntry`] from a raw C pointer.
+    ///
+    /// # Safety
+    ///
+    /// * `ptr` must be valid for at least the lifetime of the returned reference.
+    /// * `ptr` has the correct file system type, or `T` is [`super::UnspecifiedFS`].
+    pub(crate) unsafe fn from_raw<'a>(ptr: *mut bindings::dentry) -> &'a Self {
+        // SAFETY: The safety requirements guarantee that the reference is and remains valid.
+        unsafe { &*ptr.cast::<Self>() }
+    }
+
+    /// Returns the superblock of the dentry.
+    pub fn super_block(&self) -> &SuperBlock<T> {
+        // SAFETY: `d_sb` is immutable, so it's safe to read it.
+        unsafe { SuperBlock::from_raw((*self.0.get()).d_sb) }
+    }
+
+    /// Returns the inode the dentry points to, if it is a positive dentry.
+    pub fn inode(&self) -> Option<&INode<T>> {
+        // SAFETY: The dentry is valid. `d_inode` is read once, which is what the C side does in
+        // paths that may race with the dentry being made negative or positive.
+        let ptr = unsafe { ptr::read_volatile(ptr::addr_of!((*self.0.get()).d_inode)) };
+        if ptr.is_null() {
+            None
+        } else {
+            // SAFETY: A dentry keeps its inode alive for as long as it points to it.
+            Some(unsafe { INode::from_raw(ptr) })
+        }
+    }
+}
+
+/// A dentry that is known to be unhashed.
+pub struct Unhashed<'a, T: FileSystem + ?Sized>(pub(crate) &'a DEntry<T>);
+
+impl<T: FileSystem + ?Sized> Unhashed<'_, T> {
+    /// Splices a disconnected dentry into the tree if one exists.
+    pub fn splice_alias(self, inode: Option<ARef<INode<T>>>) -> Result<Option<ARef<DEntry<T>>>> {
+        let inode_ptr = if let Some(i) = inode {
+            // Reject inode if it belongs to a different superblock.
+            if !ptr::eq(i.super_block(), self.0.super_block()) {
+                return Err(EINVAL);
+            }
+
+            ManuallyDrop::new(i).0.get()
+        } else {
+            ptr::null_mut()
+        };
+
+        // SAFETY: Both inode and dentry are known to be valid.
+        let ptr = from_err_ptr(unsafe { bindings::d_splice_alias(inode_ptr, self.0 .0.get()) })?;
+
+        // SAFETY: The C API guarantees that if a dentry is returned, the refcount has been
+        // incremented.
+        Ok(ptr::NonNull::new(ptr).map(|v| unsafe { ARef::from_raw(v.cast::<DEntry<T>>()) }))
+    }
+
+    /// Binds a new inode to this dentry and hashes it, as a file system does at the end of
+    /// `create`, `mkdir` or `symlink`. The inode reference moves into the dentry.
+    pub fn instantiate(self, inode: ARef<INode<T>>) -> Result {
+        if !ptr::eq(inode.super_block(), self.0.super_block()) {
+            return Err(EINVAL);
+        }
+        let inode_ptr = ManuallyDrop::new(inode).0.get();
+        // SAFETY: Both are valid; `d_instantiate` takes over the inode reference.
+        unsafe { bindings::d_instantiate(self.0 .0.get(), inode_ptr) };
+        Ok(())
+    }
+
+    /// Returns the name of the dentry.
+    ///
+    /// Being unhashed guarantees that the name won't change.
+    pub fn name(&self) -> &[u8] {
+        self.0.name()
+    }
+}
+
+impl<T: FileSystem + ?Sized> DEntry<T> {
+    /// Returns the name of the dentry.
+    ///
+    /// The name of a hashed dentry can change under a rename; callers hold the parent
+    /// directory's lock, as every inode operation that is handed a dentry does.
+    pub fn name(&self) -> &[u8] {
+        // SAFETY: The dentry is valid; the caller holds the lock that keeps the name stable.
+        let name = unsafe { &*ptr::addr_of!((*self.0.get()).__bindgen_anon_1.d_name) };
+        // SAFETY: As above.
+        unsafe { qstr_bytes(name) }
+    }
+}
+
+/// Returns the bytes of a `qstr`.
+///
+/// # Safety
+///
+/// `name` must be valid and must not change while the returned slice is in use.
+pub(crate) unsafe fn qstr_bytes<'a>(name: &'a bindings::qstr) -> &'a [u8] {
+    // This ensures that a `u32` is representable in `usize`. If it isn't, we'll get a build
+    // break.
+    const _: usize = 0xffffffff;
+
+    // SAFETY: The union just allows an easy way to get the `hash` and `len` at once. `len` is
+    // always valid.
+    let len = unsafe { name.__bindgen_anon_1.__bindgen_anon_1.len } as usize;
+
+    // SAFETY: The caller guarantees the name is valid and stable.
+    unsafe { core::slice::from_raw_parts(name.name, len) }
+}
+
+impl<T: FileSystem + ?Sized> Deref for Unhashed<'_, T> {
+    type Target = DEntry<T>;
+
+    fn deref(&self) -> &Self::Target {
+        self.0
+    }
+}
+
+/// A dentry that is meant to be used as the root of a file system.
+pub struct Root<T: FileSystem + ?Sized>(ARef<DEntry<T>>);
+
+impl<T: FileSystem + ?Sized> Root<T> {
+    /// Creates a root dentry.
+    pub fn try_new(inode: ARef<INode<T>>) -> Result<Root<T>> {
+        // SAFETY: `d_make_root` requires that `inode` be valid and referenced, which is the
+        // case for this call.
+        //
+        // It takes over the inode, even on failure, so we don't need to clean it up.
+        let dentry_ptr = unsafe { bindings::d_make_root(ManuallyDrop::new(inode).0.get()) };
+        let dentry = ptr::NonNull::new(dentry_ptr).ok_or(ENOMEM)?;
+
+        // SAFETY: `dentry` is valid and referenced. It reference ownership is transferred to
+        // `ARef`.
+        Ok(Root(unsafe { ARef::from_raw(dentry.cast::<DEntry<T>>()) }))
+    }
+}
+
+impl<T: FileSystem + ?Sized> Deref for Root<T> {
+    type Target = DEntry<T>;
+
+    fn deref(&self) -> &Self::Target {
+        &self.0
+    }
+}
+
+/// Operations implemented by dentries.
+#[vtable]
+pub trait Operations {
+    /// File system that these operations are compatible with.
+    type FileSystem: FileSystem + ?Sized;
+
+    /// Decides whether a cached dentry still describes the file system.
+    ///
+    /// `parent` is the directory the dentry was found in and `name` its name there. Returns
+    /// `Ok(true)` to keep the dentry and `Ok(false)` to have the VFS drop it and look the name up
+    /// again. Called with the RCU read-side lock held when `rcu` is true; implementations that
+    /// would have to sleep return `Err(ECHILD)` in that case to be called again without it.
+    fn revalidate(
+        _parent: &INode<Self::FileSystem>,
+        _name: &[u8],
+        _dentry: &DEntry<Self::FileSystem>,
+        _rcu: bool,
+    ) -> Result<bool> {
+        Ok(true)
+    }
+}
+
+/// Represents dentry operations.
+pub struct Ops<T: FileSystem + ?Sized>(
+    pub(crate) *const bindings::dentry_operations,
+    PhantomData<T>,
+);
+
+impl<T: FileSystem + ?Sized> Ops<T> {
+    /// Creates the dentry operations from a type that implements the [`Operations`] trait.
+    pub const fn new<U: Operations<FileSystem = T> + ?Sized>() -> Self {
+        struct Table<T: Operations + ?Sized>(PhantomData<T>);
+        impl<T: Operations + ?Sized> Table<T> {
+            const TABLE: bindings::dentry_operations = bindings::dentry_operations {
+                d_revalidate: if T::HAS_REVALIDATE {
+                    Some(Self::revalidate_callback)
+                } else {
+                    None
+                },
+                ..pin_init::zeroed()
+            };
+
+            unsafe extern "C" fn revalidate_callback(
+                parent_ptr: *mut bindings::inode,
+                name_ptr: *const bindings::qstr,
+                dentry_ptr: *mut bindings::dentry,
+                flags: u32,
+            ) -> core::ffi::c_int {
+                from_result(|| {
+                    // SAFETY: The C API guarantees that `parent_ptr` is a valid inode.
+                    let parent = unsafe { INode::from_raw(parent_ptr) };
+                    // SAFETY: The C API guarantees that `name_ptr` is valid and stable for the
+                    // duration of the call.
+                    let name = unsafe { qstr_bytes(&*name_ptr) };
+                    // SAFETY: The C API guarantees that `dentry_ptr` is a valid dentry.
+                    let dentry = unsafe { DEntry::from_raw(dentry_ptr) };
+                    let rcu = flags & bindings::LOOKUP_RCU != 0;
+                    Ok(T::revalidate(parent, name, dentry, rcu)?.into())
+                })
+            }
+        }
+        Self(&Table::<U>::TABLE, PhantomData)
+    }
+}
