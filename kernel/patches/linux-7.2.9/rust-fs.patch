+/// A point in time as seconds and nanoseconds since the Unix epoch.
+///
+/// This is C's `struct timespec64`.
+#[derive(Clone, Copy, Default, PartialEq, Eq)]
+pub struct Timespec {
+    /// Whole seconds.
+    pub sec: i64,
+    /// Nanoseconds within the second.
+    pub nsec: u32,
+}
+
+impl Timespec {
+    /// The Unix epoch.
+    pub const EPOCH: Self = Self { sec: 0, nsec: 0 };
+
+    /// Builds a timespec from nanoseconds since the epoch.
+    pub const fn from_nanos(ns: i64) -> Self {
+        Self {
+            sec: ns.div_euclid(1_000_000_000),
+            nsec: ns.rem_euclid(1_000_000_000) as u32,
+        }
+    }
+}
+
+impl From<Timespec> for bindings::timespec64 {
+    fn from(t: Timespec) -> Self {
+        Self {
+            tv_sec: t.sec,
+            tv_nsec: isize::try_from(t.nsec).unwrap_or(0),
+        }
+    }
+}
