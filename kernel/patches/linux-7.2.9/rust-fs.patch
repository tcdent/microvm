+/// The result of looking an inode up by number: either one already in the cache, or a new one
+/// that still has to be initialised.
+pub enum Found<T: FileSystem + ?Sized> {
+    /// The inode was in the cache.
+    Existing(ARef<INode<T>>),
+    /// A new, locked inode was allocated.
+    New(New<T>),
+}
+
+/// An inode that is locked and hasn't been initialised yet.
+///
+/// # Invariants
+///
+/// The inode is a new one, locked, and valid for write.
+pub struct New<T: FileSystem + ?Sized>(
+    pub(crate) ptr::NonNull<bindings::inode>,
+    pub(crate) PhantomData<T>,
+);
+
+impl<T: FileSystem + ?Sized> New<T> {
+    /// Initialises the new inode with the given parameters.
+    pub fn init(self, params: Params<T::INodeData>) -> Result<ARef<INode<T>>> {
+        // SAFETY: Every inode of this file system is embedded in a `WithData`.
+        let outerp = unsafe { container_of!(self.0.as_ptr(), WithData<T::INodeData>, inode) };
+
+        // SAFETY: This is a newly-created inode. No other references to it exist, so it is
+        // safe to mutably dereference it.
+        let outer = unsafe { &mut *outerp };
+
+        // N.B. We must always write this to a newly allocated inode because the free callback
+        // expects the data to be initialised and drops it.
+        outer.data.write(params.value);
+
+        let inode = &mut outer.inode;
+        let mode = match params.typ {
+            Type::Dir => bindings::S_IFDIR,
+            Type::Reg => bindings::S_IFREG,
+            Type::Lnk => bindings::S_IFLNK,
+            Type::Fifo => {
+                // SAFETY: `inode` is valid for write as it's a new inode.
+                unsafe { bindings::init_special_inode(inode, bindings::S_IFIFO as _, 0) };
+                bindings::S_IFIFO
+            }
+            Type::Sock => {
+                // SAFETY: `inode` is valid for write as it's a new inode.
+                unsafe { bindings::init_special_inode(inode, bindings::S_IFSOCK as _, 0) };
+                bindings::S_IFSOCK
+            }
+            Type::Chr(major, minor) => {
+                // SAFETY: `inode` is valid for write as it's a new inode.
+                unsafe {
+                    bindings::init_special_inode(
+                        inode,
+                        bindings::S_IFCHR as _,
+                        bindings::MKDEV(major, minor & bindings::MINORMASK),
+                    )
+                };
+                bindings::S_IFCHR
+            }
+            Type::Blk(major, minor) => {
+                // SAFETY: `inode` is valid for write as it's a new inode.
+                unsafe {
+                    bindings::init_special_inode(
+                        inode,
+                        bindings::S_IFBLK as _,
+                        bindings::MKDEV(major, minor & bindings::MINORMASK),
+                    )
+                };
+                bindings::S_IFBLK
+            }
+        };
+
+        inode.i_mode = u16::try_from(mode)?;
+
+        // SAFETY: inode is a new inode, so it is valid for write.
+        unsafe { INode::<T>::from_raw(inode).set_attr(&params.attr) };
+
+        // SAFETY: inode is a new inode, so it is valid for write.
+        unsafe { bindings::unlock_new_inode(inode) };
+
+        let manual = ManuallyDrop::new(self);
+        // SAFETY: We transferred ownership of the refcount to `ARef` by preventing `drop` from
+        // being called with the `ManuallyDrop` instance created above.
+        Ok(unsafe { ARef::from_raw(manual.0.cast::<INode<T>>()) })
+    }
+
+    /// Sets the inode operations on this new inode.
+    pub fn set_iops(&mut self, iops: Ops<T>) -> &mut Self {
+        // SAFETY: By the type invariants, it's ok to modify the inode.
+        let inode = unsafe { self.0.as_mut() };
+        inode.i_op = iops.0;
+        self
+    }
+
+    /// Sets the file operations on this new inode.
+    pub fn set_fops(&mut self, fops: file::Ops<T>) -> &mut Self {
+        // SAFETY: By the type invariants, it's ok to modify the inode.
+        let inode = unsafe { self.0.as_mut() };
+        inode.__bindgen_anon_3.i_fop = fops.0;
+        self
+    }
+
+    /// Marks the inode as DAX: its data is accessed in place, never through the page cache.
+    pub fn set_dax(&mut self) -> &mut Self {
+        // SAFETY: By the type invariants, it's ok to modify the inode.
+        let inode = unsafe { self.0.as_mut() };
+        inode.i_flags |= bindings::S_DAX;
+        self
+    }
+
+    /// Sets the address space operations on this new inode.
+    pub fn set_aops(&mut self, aops: address_space::Ops<T>) -> &mut Self {
+        // SAFETY: By the type invariants, it's ok to modify the inode.
+        let inode = unsafe { self.0.as_mut() };
+        inode.i_data.a_ops = aops.0;
+        self
+    }
+}
+
+impl<T: FileSystem + ?Sized> Drop for New<T> {
+    fn drop(&mut self) {
+        // SAFETY: The new inode failed to be turned into an initialised inode, so it's safe (and
+        // in fact required) to call `iget_failed` on it.
+        unsafe { bindings::iget_failed(self.0.as_ptr()) };
+    }
+}
+
+/// The type of an inode.
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub enum Type {
+    /// Named pipe (first-in, first-out) type.
+    Fifo,
+
+    /// Character device type.
+    Chr(u32, u32),
+
+    /// Directory type.
+    Dir,
+
+    /// Block device type.
+    Blk(u32, u32),
+
+    /// Regular file type.
+    Reg,
+
+    /// Symbolic link type.
+    Lnk,
+
+    /// Named unix-domain socket type.
+    Sock,
+}
+
+/// The attributes of an inode other than its type.
+#[derive(Clone, Copy, Default)]
+pub struct Attr {
+    /// The permission bits, including setuid, setgid and sticky.
+    pub mode: u16,
+
+    /// Size of the contents of the inode.
+    ///
+    /// Its maximum value is [`super::MAX_LFS_FILESIZE`].
+    pub size: Offset,
+
+    /// Number of 512-byte blocks.
+    pub blocks: u64,
+
+    /// Number of links to the inode.
+    pub nlink: u32,
+
+    /// User id.
+    pub uid: u32,
+
+    /// Group id.
+    pub gid: u32,
+
+    /// Last status change time.
+    pub ctime: Timespec,
+
+    /// Last modification time.
+    pub mtime: Timespec,
+
+    /// Last access time.
+    pub atime: Timespec,
+}
+
+/// Required inode parameters.
+///
+/// This is used when creating new inodes.
+pub struct Params<T> {
+    /// Type of inode.
+    pub typ: Type,
+
+    /// Everything else about the inode.
+    pub attr: Attr,
+
+    /// Value to attach to this node.
+    pub value: T,
+}
+
+/// Represents inode operations.
+pub struct Ops<T: FileSystem + ?Sized>(*const bindings::inode_operations, PhantomData<T>);
+
+impl<T: FileSystem + ?Sized> Ops<T> {
+    /// Creates the inode operations from a type that implements the [`Operations`] trait.
+    pub const fn new<U: Operations<FileSystem = T> + ?Sized>() -> Self {
+        struct Table<T: Operations + ?Sized>(PhantomData<T>);
+        impl<T: Operations + ?Sized> Table<T> {
+            const TABLE: bindings::inode_operations = bindings::inode_operations {
+                lookup: if T::HAS_LOOKUP {
+                    Some(Self::lookup_callback)
+                } else {
+                    None
+                },
+                get_link: if T::HAS_GET_LINK {
+                    Some(Self::get_link_callback)
+                } else {
+                    None
+                },
+                create: if T::HAS_CREATE {
+                    Some(Self::create_callback)
+                } else {
+                    None
+                },
+                mkdir: if T::HAS_MKDIR {
+                    Some(Self::mkdir_callback)
+                } else {
+                    None
+                },
+                symlink: if T::HAS_SYMLINK {
+                    Some(Self::symlink_callback)
+                } else {
+                    None
+                },
+                link: if T::HAS_LINK {
+                    Some(Self::link_callback)
+                } else {
+                    None
+                },
+                unlink: if T::HAS_UNLINK {
+                    Some(Self::unlink_callback)
+                } else {
+                    None
+                },
+                rmdir: if T::HAS_RMDIR {
+                    Some(Self::rmdir_callback)
+                } else {
+                    None
+                },
+                rename: if T::HAS_RENAME {
+                    Some(Self::rename_callback)
+                } else {
+                    None
+                },
+                setattr: if T::HAS_SETATTR {
+                    Some(Self::setattr_callback)
+                } else {
+                    None
+                },
+                ..pin_init::zeroed()
+            };
+
+            /// The directory the VFS locked exclusively before calling a mutating operation.
+            ///
+            /// # Safety
+            ///
+            /// `dir` must be a valid inode whose rw semaphore is held exclusively.
+            unsafe fn locked_dir<'a>(
+                dir: *mut bindings::inode,
+            ) -> ManuallyDrop<Locked<&'a INode<T::FileSystem>, WriteSem>> {
+                // SAFETY: Per the safety requirements.
+                let parent = unsafe { INode::from_raw(dir) };
+                // SAFETY: The VFS holds the lock and expects it to be held on return, hence
+                // the `ManuallyDrop`.
+                ManuallyDrop::new(unsafe { Locked::new(parent) })
+            }
+
+            unsafe extern "C" fn create_callback(
+                _idmap: *mut bindings::mnt_idmap,
+                dir: *mut bindings::inode,
+                dentry_ptr: *mut bindings::dentry,
+                mode: bindings::umode_t,
+                excl: bool,
+            ) -> ffi::c_int {
+                from_result(|| {
+                    // SAFETY: The VFS passes a valid, exclusively locked directory.
+                    let parent = unsafe { Self::locked_dir(dir) };
+                    // SAFETY: The VFS passes a valid, unhashed dentry.
+                    let dentry = unsafe { DEntry::from_raw(dentry_ptr) };
+                    let inode = T::create(&parent, dentry::Unhashed(dentry), mode & 0o7777, excl)?;
+                    dentry::Unhashed(dentry).instantiate(inode)?;
+                    Ok(0)
+                })
+            }
+
+            unsafe extern "C" fn mkdir_callback(
+                _idmap: *mut bindings::mnt_idmap,
+                dir: *mut bindings::inode,
+                dentry_ptr: *mut bindings::dentry,
+                mode: bindings::umode_t,
+            ) -> *mut bindings::dentry {
+                let result = (|| {
+                    // SAFETY: The VFS passes a valid, exclusively locked directory.
+                    let parent = unsafe { Self::locked_dir(dir) };
+                    // SAFETY: The VFS passes a valid, unhashed dentry.
+                    let dentry = unsafe { DEntry::from_raw(dentry_ptr) };
+                    let inode = T::mkdir(&parent, dentry::Unhashed(dentry), mode & 0o7777)?;
+                    dentry::Unhashed(dentry).instantiate(inode)
+                })();
+                match result {
+                    // Null tells the VFS the dentry it passed is the one to use.
+                    Ok(()) => ptr::null_mut(),
+                    Err(e) => e.to_ptr(),
+                }
+            }
+
+            unsafe extern "C" fn symlink_callback(
+                _idmap: *mut bindings::mnt_idmap,
+                dir: *mut bindings::inode,
+                dentry_ptr: *mut bindings::dentry,
+                target: *const ffi::c_char,
+            ) -> ffi::c_int {
+                from_result(|| {
+                    // SAFETY: The VFS passes a valid, exclusively locked directory.
+                    let parent = unsafe { Self::locked_dir(dir) };
+                    // SAFETY: The VFS passes a valid, unhashed dentry.
+                    let dentry = unsafe { DEntry::from_raw(dentry_ptr) };
+                    // SAFETY: The VFS passes a NUL-terminated target that outlives the call.
+                    let target = unsafe { CStr::from_char_ptr(target) };
+                    let inode = T::symlink(&parent, dentry::Unhashed(dentry), target)?;
+                    dentry::Unhashed(dentry).instantiate(inode)?;
+                    Ok(0)
+                })
+            }
+
+            unsafe extern "C" fn link_callback(
+                old_ptr: *mut bindings::dentry,
+                dir: *mut bindings::inode,
+                dentry_ptr: *mut bindings::dentry,
+            ) -> ffi::c_int {
+                from_result(|| {
+                    // SAFETY: The VFS passes a valid, exclusively locked directory.
+                    let parent = unsafe { Self::locked_dir(dir) };
+                    // SAFETY: The VFS passes valid dentries; the new one is unhashed.
+                    let old = unsafe { DEntry::from_raw(old_ptr) };
+                    // SAFETY: As above.
+                    let dentry = unsafe { DEntry::from_raw(dentry_ptr) };
+                    let inode = T::link(old, &parent, dentry::Unhashed(dentry))?;
+                    dentry::Unhashed(dentry).instantiate(inode)?;
+                    Ok(0)
+                })
+            }
+
+            unsafe extern "C" fn unlink_callback(
+                dir: *mut bindings::inode,
+                dentry_ptr: *mut bindings::dentry,
+            ) -> ffi::c_int {
+                from_result(|| {
+                    // SAFETY: The VFS passes a valid, exclusively locked directory.
+                    let parent = unsafe { Self::locked_dir(dir) };
+                    // SAFETY: The VFS passes a valid dentry.
+                    let dentry = unsafe { DEntry::from_raw(dentry_ptr) };
+                    T::unlink(&parent, dentry)?;
+                    Ok(0)
+                })
+            }
+
+            unsafe extern "C" fn rmdir_callback(
+                dir: *mut bindings::inode,
+                dentry_ptr: *mut bindings::dentry,
+            ) -> ffi::c_int {
+                from_result(|| {
+                    // SAFETY: The VFS passes a valid, exclusively locked directory.
+                    let parent = unsafe { Self::locked_dir(dir) };
+                    // SAFETY: The VFS passes a valid dentry.
+                    let dentry = unsafe { DEntry::from_raw(dentry_ptr) };
+                    T::rmdir(&parent, dentry)?;
+                    Ok(0)
+                })
+            }
+
+            unsafe extern "C" fn rename_callback(
+                _idmap: *mut bindings::mnt_idmap,
+                old_dir: *mut bindings::inode,
+                old_ptr: *mut bindings::dentry,
+                new_dir: *mut bindings::inode,
+                new_ptr: *mut bindings::dentry,
+                flags: ffi::c_uint,
+            ) -> ffi::c_int {
+                from_result(|| {
+                    // SAFETY: The VFS locked both directories (once, if they are the same)
+                    // before calling and unlocks them after.
+                    let old_parent = unsafe { Self::locked_dir(old_dir) };
+                    // SAFETY: As above.
+                    let new_parent = unsafe { Self::locked_dir(new_dir) };
+                    // SAFETY: The VFS passes valid dentries.
+                    let old = unsafe { DEntry::from_raw(old_ptr) };
+                    // SAFETY: As above.
+                    let new = unsafe { DEntry::from_raw(new_ptr) };
+                    T::rename(&old_parent, old, &new_parent, new, flags)?;
+                    Ok(0)
+                })
+            }
+
+            unsafe extern "C" fn setattr_callback(
+                idmap: *mut bindings::mnt_idmap,
+                dentry_ptr: *mut bindings::dentry,
+                attr: *mut bindings::iattr,
+            ) -> ffi::c_int {
+                from_result(|| {
+                    // SAFETY: All three pointers are valid per the callback contract. This is
+                    // the generic permission check every file system runs first.
+                    to_result(unsafe { bindings::setattr_prepare(idmap, dentry_ptr, attr) })?;
+                    // SAFETY: The VFS passes a valid dentry.
+                    let dentry = unsafe { DEntry::from_raw(dentry_ptr) };
+                    let inode = dentry.inode().ok_or(EINVAL)?;
+                    // SAFETY: The VFS holds the inode's rw semaphore exclusively around
+                    // `setattr` and expects it held on return.
+                    let locked = ManuallyDrop::new(unsafe { Locked::<_, WriteSem>::new(inode) });
+                    // SAFETY: `attr` is valid for the call.
+                    T::setattr(dentry, &locked, unsafe { SetAttr::from_raw(attr) })?;
+                    Ok(0)
+                })
+            }
+
+            unsafe extern "C" fn lookup_callback(
+                parent_ptr: *mut bindings::inode,
+                dentry_ptr: *mut bindings::dentry,
+                _flags: u32,
+            ) -> *mut bindings::dentry {
+                // SAFETY: The C API guarantees that `parent_ptr` is a valid inode.
+                let parent = unsafe { INode::from_raw(parent_ptr) };
+
+                // SAFETY: The C API guarantees that `dentry_ptr` is a valid dentry.
+                let dentry = unsafe { DEntry::from_raw(dentry_ptr) };
+
+                // SAFETY: The C API guarantees that the inode's rw semaphore is locked at least in
+                // read mode. It does not expect callees to unlock it, so we make the locked object
+                // manually dropped to avoid unlocking it.
+                let locked = ManuallyDrop::new(unsafe { Locked::new(parent) });
+
+                match T::lookup(&locked, dentry::Unhashed(dentry)) {
+                    Err(e) => e.to_ptr(),
+                    Ok(None) => ptr::null_mut(),
+                    Ok(Some(ret)) => ManuallyDrop::new(ret).0.get(),
+                }
+            }
+
+            unsafe extern "C" fn get_link_callback(
+                dentry_ptr: *mut bindings::dentry,
+                inode_ptr: *mut bindings::inode,
+                delayed_call: *mut bindings::delayed_call,
+            ) -> *const crate::ffi::c_char {
+                unsafe extern "C" fn drop_link(ptr: *mut crate::ffi::c_void) {
+                    // SAFETY: The argument came from a previous call to `into_foreign` below.
+                    unsafe { drop(KBox::<CString>::from_foreign(ptr)) };
+                }
+
+                let dentry = if dentry_ptr.is_null() {
+                    None
+                } else {
+                    // SAFETY: The C API guarantees that `dentry_ptr` is a valid dentry when it's
+                    // non-null.
+                    Some(unsafe { DEntry::from_raw(dentry_ptr) })
+                };
+
+                // SAFETY: The C API guarantees that `inode_ptr` is a valid inode.
+                let inode = unsafe { INode::from_raw(inode_ptr) };
+
+                let link = match T::get_link(dentry, inode) {
+                    Err(e) => return e.to_ptr::<crate::ffi::c_char>(),
+                    Ok(link) => link,
+                };
+
+                // The link is handed to the VFS, which frees it through `delayed_call` once the
+                // path walk no longer needs it. `GFP_ATOMIC` because this may run under RCU.
+                let boxed = match KBox::new(link, crate::alloc::flags::GFP_ATOMIC) {
+                    Ok(b) => b,
+                    Err(_) => return ENOMEM.to_ptr::<crate::ffi::c_char>(),
+                };
+                let name = boxed.as_char_ptr();
+                // SAFETY: `delayed_call` is valid per the callback contract; the pointer passed is
+                // the one `drop_link` expects.
+                unsafe {
+                    bindings::set_delayed_call(
+                        delayed_call,
+                        Some(drop_link),
+                        KBox::into_foreign(boxed),
+                    )
+                };
+                name
+            }
+        }
+        Self(&Table::<U>::TABLE, PhantomData)
+    }
+}
diff -ruN a/rust/kernel/fs/sb.rs b/rust/kernel/fs/sb.rs
--- a/rust/kernel/fs/sb.rs	1969-12-31 16:00:00.000000000 -0800
+++ b/rust/kernel/fs/sb.rs	2026-11-23 14:31:43.039579444 -0800
@@ -0,0 +1,159 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! File system super blocks.
+//!
+//! This module allows Rust code to use superblocks.
+//!
+//! C headers: [`include/linux/fs.h`](srctree/include/linux/fs.h)
+
+use super::inode::{self, INode, Ino};
+use super::FileSystem;
+use crate::error::{code::*, Result};
+use crate::sync::aref::ARef;
+use crate::types::{ForeignOwnable, Opaque};
+use crate::{bindings, build_error};
+use core::{marker::PhantomData, ptr};
+
+/// A typestate for [`SuperBlock`] that indicates that it's a new one, so not fully initialized
+/// yet.
+pub struct New;
+
+/// A typestate for [`SuperBlock`] that indicates that it's ready to be used.
+pub struct Ready;
+
+// SAFETY: Instances of `SuperBlock<T, Ready>` are only created after initialising the data.
+unsafe impl DataInited for Ready {}
+
+/// Indicates that a superblock in this typestate has data initialized.
+///
+/// # Safety
+///
+/// Implementers must ensure that `s_fs_info` is properly initialised in this state.
+#[doc(hidden)]
+pub unsafe trait DataInited {}
+
+/// A file system super block.
+///
+/// Wraps the kernel's `struct super_block`.
+#[repr(transparent)]
+pub struct SuperBlock<T: FileSystem + ?Sized, S = Ready>(
+    pub(crate) Opaque<bindings::super_block>,
+    PhantomData<(S, T)>,
+);
+
+impl<T: FileSystem + ?Sized, S> SuperBlock<T, S> {
+    /// Creates a new superblock reference from the given raw pointer.
+    ///
+    /// # Safety
+    ///
+    /// Callers must ensure that:
+    ///
+    /// * `ptr` is valid and remains so for the lifetime of the returned object.
+    /// * `ptr` has the correct file system type, or `T` is [`super::UnspecifiedFS`].
+    /// * `ptr` in the right typestate.
+    pub(crate) unsafe fn from_raw<'a>(ptr: *mut bindings::super_block) -> &'a Self {
+        // SAFETY: The safety requirements guarantee that the cast below is ok.
+        unsafe { &*ptr.cast::<Self>() }
+    }
+
+    /// Creates a new superblock mutable reference from the given raw pointer.
+    ///
+    /// # Safety
+    ///
+    /// Callers must ensure that:
+    ///
+    /// * `ptr` is valid and remains so for the lifetime of the returned object.
+    /// * `ptr` has the correct file system type, or `T` is [`super::UnspecifiedFS`].
+    /// * `ptr` in the right typestate.
+    /// * `ptr` is the only active pointer to the superblock.
+    pub(crate) unsafe fn from_raw_mut<'a>(ptr: *mut bindings::super_block) -> &'a mut Self {
+        // SAFETY: The safety requirements guarantee that the cast below is ok.
+        unsafe { &mut *ptr.cast::<Self>() }
+    }
+
+    /// Returns whether the superblock is mounted in read-only mode.
+    pub fn rdonly(&self) -> bool {
+        // SAFETY: `s_flags` only changes during init, so it is safe to read it.
+        unsafe { (*self.0.get()).s_flags & bindings::SB_RDONLY != 0 }
+    }
+}
+
+impl<T: FileSystem + ?Sized> SuperBlock<T, New> {
+    /// Sets the magic number of the superblock.
+    pub fn set_magic(&mut self, magic: usize) -> &mut Self {
+        // SAFETY: This is a new superblock that is being initialised, so it's ok to write to its
+        // fields.
+        unsafe { (*self.0.get()).s_magic = magic as crate::ffi::c_ulong };
+        self
+    }
+}
+
+impl<T: FileSystem + ?Sized, S: DataInited> SuperBlock<T, S> {
+    /// Returns the data associated with the superblock.
+    pub fn data(&self) -> <T::Data as ForeignOwnable>::Borrowed<'_> {
+        if T::IS_UNSPECIFIED {
+            build_error!("super block data type is unspecified");
+        }
+
+        // SAFETY: This method is only available if the typestate implements `DataInited`, whose
+        // safety requirements include `s_fs_info` being properly initialised.
+        let ptr = unsafe { (*self.0.get()).s_fs_info };
+        // SAFETY: `s_fs_info` holds the result of `into_foreign` and is only consumed in
+        // `kill_sb`, after the last use of the superblock.
+        unsafe { T::Data::borrow(ptr) }
+    }
+
+    /// Tries to get an existing inode or create a new one if it doesn't exist yet.
+    ///
+    /// This method is not callable from a superblock where data isn't inited yet because it would
+    /// allow one to get access to the uninited data via `inode::New::init()` ->
+    /// `INode::super_block()` -> `SuperBlock::data()`.
+    pub fn get_or_create_inode(&self, ino: Ino) -> Result<inode::Found<T>> {
+        // SAFETY: All superblock-related state needed by `iget_locked` is initialised by C code
+        // before calling `fill_super_callback`, or by `fill_super_callback` itself before calling
+        // `fill_super`, which is the first function to see a new superblock.
+        let inode =
+            ptr::NonNull::new(unsafe { bindings::iget_locked(self.0.get(), ino.try_into()?) }).ok_or(ENOMEM)?;
+
+        // SAFETY: `inode` is a valid pointer returned by `iget_locked`.
+        let state = unsafe { bindings::inode_state_read_once(inode.as_ptr()) };
+
+        if state & bindings::inode_state_flags_enum_I_NEW == 0 {
+            // The inode is cached. Just return it.
+            //
+            // SAFETY: `inode` had its refcount incremented by `iget_locked`; this increment is now
+            // owned by `ARef`.
+            Ok(inode::Found::Existing(unsafe { ARef::from_raw(inode.cast()) }))
+        } else {
+            // SAFETY: The new inode is valid but not fully initialised yet, so it's ok to create a
+            // `inode::New`.
+            Ok(inode::Found::New(inode::New(inode, PhantomData)))
+        }
+    }
+
+    /// Creates an inode with the given inode number.
+    ///
+    /// Fails with `EEXIST` if an inode with the given number already exists.
+    pub fn create_inode(&self, ino: Ino) -> Result<inode::New<T>> {
+        match self.get_or_create_inode(ino)? {
+            inode::Found::New(new) => Ok(new),
+            inode::Found::Existing(_) => Err(EEXIST),
+        }
+    }
+}
+
+impl<T: FileSystem + ?Sized> SuperBlock<T> {
+    /// Drops every unused dentry of this superblock, forcing fresh lookups.
+    pub fn shrink_dcache(&self) {
+        // SAFETY: The superblock is valid.
+        unsafe { bindings::shrink_dcache_sb(self.0.get()) };
+    }
+
+    /// Returns the inode with the given number if it is cached.
+    pub fn cached_inode(&self, ino: Ino) -> Option<ARef<INode<T>>> {
+        // SAFETY: The superblock is valid; `ilookup` takes a reference on success.
+        let ptr = ptr::NonNull::new(unsafe { bindings::ilookup(self.0.get(), ino.try_into().ok()?) })?;
+        // SAFETY: `ilookup` returned a referenced inode; the reference is now owned by `ARef`.
+        Some(unsafe { ARef::from_raw(ptr.cast()) })
+    }
+}
diff -ruN a/rust/kernel/fs.rs b/rust/kernel/fs.rs
--- a/rust/kernel/fs.rs	2026-11-23 14:31:42.799575743 -0800
+++ b/rust/kernel/fs.rs	2026-11-23 14:31:42.815575990 -0800
@@ -2,10 +2,474 @@
 
 //! Kernel file systems.
 //!
+//! This module lets Rust code use files and implement file systems.
+//!
 //! C headers: [`include/linux/fs.h`](srctree/include/linux/fs.h)
 
+use crate::error::{code::*, from_result, to_result, Error, Result};
+use crate::types::{ForeignOwnable, Opaque};
