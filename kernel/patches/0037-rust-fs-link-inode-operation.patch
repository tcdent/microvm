From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tcdent <tcdent@gmail.com>
Date: Mon, 12 Oct 2026 18:09:02 -0700
Subject: [PATCH 37/38] rust: fs: link inode operation

Add `link` to `inode::Operations`: the file system returns the inode to
bind to the new name, and the callback instantiates the dentry with it.

Claude-Session: https://claude.ai/code/session_01SKmspe5nVbuvzdvYZa9UhW
---
 rust/kernel/fs/inode.rs | 33 +++++++++++++++++++++++++++++++++
 1 file changed, 33 insertions(+)

diff --git a/rust/kernel/fs/inode.rs b/rust/kernel/fs/inode.rs
index 5d921587d..f8bd76143 100644
--- a/rust/kernel/fs/inode.rs
+++ b/rust/kernel/fs/inode.rs
@@ -82,6 +82,16 @@ fn symlink(
         Err(ENOTSUPP)
     }
 
+    /// Gives the file `old` a further name, `dentry` in `parent`, and returns the inode to bind
+    /// to it: `old`'s own inode for a file system that tracks links per inode.
+    fn link(
+        _old: &DEntry<Self::FileSystem>,
+        _parent: &Locked<&INode<Self::FileSystem>, WriteSem>,
+        _dentry: dentry::Unhashed<'_, Self::FileSystem>,
+    ) -> Result<ARef<INode<Self::FileSystem>>> {
+        Err(ENOTSUPP)
+    }
+
     /// Removes the name `dentry` from `parent`. The VFS drops the dentry afterwards; the
     /// implementation accounts for the inode's lost link.
     fn unlink(
@@ -764,6 +774,11 @@ impl<T: Operations + ?Sized> Table<T> {
                 } else {
                     None
                 },
+                link: if T::HAS_LINK {
+                    Some(Self::link_callback)
+                } else {
+                    None
+                },
                 unlink: if T::HAS_UNLINK {
                     Some(Self::unlink_callback)
                 } else {
@@ -860,6 +875,24 @@ unsafe fn locked_dir<'a>(
                 })
             }
 
+            unsafe extern "C" fn link_callback(
+                old_ptr: *mut bindings::dentry,
+                dir: *mut bindings::inode,
+                dentry_ptr: *mut bindings::dentry,
+            ) -> ffi::c_int {
+                from_result(|| {
+                    // SAFETY: The VFS passes a valid, exclusively locked directory.
+                    let parent = unsafe { Self::locked_dir(dir) };
+                    // SAFETY: The VFS passes valid dentries; the new one is unhashed.
+                    let old = unsafe { DEntry::from_raw(old_ptr) };
+                    // SAFETY: As above.
+                    let dentry = unsafe { DEntry::from_raw(dentry_ptr) };
+                    let inode = T::link(old, &parent, dentry::Unhashed(dentry))?;
+                    dentry::Unhashed(dentry).instantiate(inode)?;
+                    Ok(0)
+                })
+            }
+
             unsafe extern "C" fn unlink_callback(
                 dir: *mut bindings::inode,
                 dentry_ptr: *mut bindings::dentry,
