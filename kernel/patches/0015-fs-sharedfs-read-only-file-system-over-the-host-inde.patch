+    fn lookup(
+        parent: &Locked<&INode<Self>, inode::ReadSem>,
+        dentry: dentry::Unhashed<'_, Self>,
+    ) -> Result<Option<ARef<DEntry<Self>>>> {
+        let session = parent.super_block().data();
+        match session.index.lookup(parent.data().slot, dentry.name()) {
+            Some((slot, e)) => {
+                let inode = Self::iget(parent.super_block(), slot, &e)?;
+                dentry.splice_alias(Some(inode))
