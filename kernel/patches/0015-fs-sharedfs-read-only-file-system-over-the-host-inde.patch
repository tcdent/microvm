+
+impl Node {
+    /// Returns the read handle, opening one on first use.
+    fn read_handle(&self, ino: u64) -> Result<u64> {
+        if let Some(fh) = self.fh.as_ref() {
+            return Ok(*fh);
+        }
+        let fh = open(&self.session, ino)?;
+        if self.fh.populate(fh) {
+            return Ok(fh);
+        }
+        // Lost a race with another reader: use theirs, give ours back.
+        release(&self.session, fh);
+        self.fh.as_ref().copied().ok_or(EIO)
+    }
+}
+
+impl Drop for Node {
+    fn drop(&mut self) {
+        if let Some(fh) = self.fh.as_ref() {
+            release(&self.session, *fh);
+        }
+    }
