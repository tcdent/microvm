+        let typ = type_of(e).ok_or(EIO)?;
+        match typ {
+            inode::Type::Dir => {
+                new.set_iops(INODE_OPS).set_fops(DIR_FOPS);
+            }
+            inode::Type::Reg => {
+                new.set_fops(file::Ops::generic_ro_file())
+                    .set_aops(FILE_AOPS);
+            }
+            inode::Type::Lnk => {
+                new.set_iops(INODE_OPS);
+            }
+            _ => {}
+        }
