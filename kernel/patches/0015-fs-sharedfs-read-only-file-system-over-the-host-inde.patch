+#[vtable]
+impl address_space::Operations for SharedFs {
+    type FileSystem = Self;
+
+    fn read_folio(_: Option<&File>, mut folio: Locked<&Folio<PageCache<Self>>>) -> Result {
+        let inode = folio.inode();
+        let node = inode.data();
+        let size = folio.size().min(MAX_IO);
+        let fh = node.read_handle(inode.ino())?;
+
+        let mut req = Req::new(op::READ)
+            .u64(fh)
+            .u64(folio.pos().try_into()?)
+            .u32(size as u32);
+        // The host answers with its header, a `u32` byte count, and then the bytes, which land
+        // in the folio's page because it is the next writable buffer.
+        let page = folio.first_page();
+        let session = inode.super_block().data();
+        let (resp, n) = session.request(req.bytes(), HEADER_LEN + 4, Some((&page, size)))?;
+        drop(page);
+
+        let copied = n.checked_sub(HEADER_LEN + 4).ok_or(EIO)?;
+        let declared = Resp(&resp[HEADER_LEN..]).u32()? as usize;
+        if copied != declared || copied > size {
+            return Err(EIO);
+        }
+        folio.zero_out(copied, folio.size() - copied)?;
+        folio.mark_uptodate();
+        folio.flush_dcache();
+        Ok(())
+    }
+}
