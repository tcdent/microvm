+        fs::mode::S_IFIFO => inode::Type::Fifo,
+        fs::mode::S_IFSOCK => inode::Type::Sock,
+        fs::mode::S_IFCHR => inode::Type::Chr(major, minor),
+        fs::mode::S_IFBLK => inode::Type::Blk(major, minor),
